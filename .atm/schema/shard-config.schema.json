{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://3klife.local/schema/doc-shard-config/v0.1",
  "title": "Document Shard Config",
  "description": "Schema for managed document shard group configuration and auto-parts shard configs.",
  "type": "object",
  "required": [
    "version",
    "source",
    "indexTitle",
    "type",
    "shards"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the source file relative to the shard directory."
    },
    "indexTitle": {
      "type": "string",
      "minLength": 1
    },
    "indexPath": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "markdown-h2",
        "markdown-heading",
        "json-array",
        "json-object",
        "auto-parts"
      ]
    },
    "preambleShard": {
      "type": "string",
      "minLength": 1
    },
    "arrayPath": {
      "type": "string",
      "minLength": 1
    },
    "objectPath": {
      "type": "string",
      "minLength": 1
    },
    "shardArrayPath": {
      "type": "string",
      "minLength": 1
    },
    "splitField": {
      "type": "string",
      "minLength": 1
    },
    "defaultShard": {
      "type": "string",
      "minLength": 1
    },
    "keepSourceIntact": {
      "type": "boolean"
    },
    "_autoGenerated": {
      "type": "boolean"
    },
    "_generatedBy": {
      "type": "string"
    },
    "_thresholdKB": {
      "type": "number",
      "minimum": 1
    },
    "_thresholdLines": {
      "type": "number",
      "minimum": 1
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/shardEntry"
      }
    }
  },
  "definitions": {
    "shardEntry": {
      "type": "object",
      "required": [
        "name",
        "title"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Route pattern for markdown / json split groups."
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Inclusive item range for auto-parts shard files."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "markdown-h2",
              "markdown-heading"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shards": {
            "items": {
              "required": [
                "pattern"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "auto-parts"
          }
        }
      },
      "then": {
        "required": [
          "_thresholdKB",
          "shards"
        ]
      }
    }
  ]
}
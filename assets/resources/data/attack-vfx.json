{
  "version": 2,
  "enabled": true,
  "additive": true,
  "_comment": "戰場攻擊特效（零貼圖、加色混合單一 Graphics 節點）。引擎中立：數值、顏色、節奏全在這裡，Unity 端可原樣讀入。座標單位=畫面像素（單位高約 180px），線寬至少 minLinePx。時間單位=秒。顏色：main／glow／accent 一律 HSV S≥0.85、V=1.0，core 為近白高亮。",
  "glow": {
    "_comment": "三層眩光：外層寬暈（寬=核心×outerWidthMul、低 alpha 的 glow 色）、中層 main 色（往白微提亮 midWhiten）、內層近白核心（main 往白混 coreWhiten）。加色混合下 alpha 已接近 1，亮度靠疊畫：passes=每道筆畫三層各畫幾次（程式夾在 1~3，預設 2）。passes=1 時改套 lowEnd 的舊亮度（低階機降級）。flash=命中星形閃光（sec≤0.16）。",
    "outerWidthMul": 7.5,
    "outerAlpha": 0.55,
    "midAlpha": 1,
    "midWhiten": 0.1,
    "coreWidthMul": 0.4,
    "coreWhiten": 0.9,
    "stripOuterMul": 2.1,
    "stripCoreMul": 0.4,
    "passes": 2,
    "lowEnd": {
      "_comment": "passes=1（低階機）時覆寫為舊亮度",
      "outerWidthMul": 6,
      "outerAlpha": 0.45,
      "midWhiten": 0,
      "coreWhiten": 0.85,
      "flash": { "rays": 6, "lenPx": 44, "widthPx": 4.5, "coreRadiusPx": 11, "sec": 0.11 }
    },
    "flash": { "rays": 6, "lenPx": 56, "widthPx": 5.8, "coreRadiusPx": 14, "sec": 0.13 }
  },
  "budget": {
    "_comment": "全場上限：同時存在的特效筆數與粒子（火花／光點／速度線／尾跡段）總數。超過就縮減粒子或略過該筆，不新增節點。",
    "maxEffects": 10,
    "maxParticles": 64,
    "minLinePx": 2
  },

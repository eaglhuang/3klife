{
  "_comment": "PROG-2-9729：戰鬥音效分層。clip 名稱＝assets/bundles/audio/clips 內檔名（無副檔名），hit_*／footstep_* 是 tools_node/gen-audio-variants.js 預先產生的變調版本（引擎 AudioSource 不支援 pitch）。volume 為 [最小,最大] 隨機範圍。讀不到本檔時用 BattleAudioLayers.ts 的預設值。",
  "hit": {
    "heavyMaxHpRatio": 0.2,
    "critIsHeavy": true,
    "shieldTroopBlocks": true,
    "tiers": {
      "light": { "clips": ["hit_light", "hurt"], "volume": [0.7, 0.9] },
      "heavy": { "clips": ["hit_heavy"], "volume": [0.9, 1.0] },
      "block": { "clips": ["hit_block"], "volume": [0.8, 1.0] },
      "lethal": { "clips": ["hit_lethal"], "volume": [0.95, 1.0] }
    }
  },
  "footstep": {
    "clips": {
      "infantry": "footstep",
      "pikeman": "footstep",
      "shield": "footstep_heavy",
      "engineer": "footstep_heavy",
      "archer": "footstep_light",
      "medic": "footstep_light",
      "cavalry": "footstep_hoof"
    },
    "volumeScale": [0.8, 1.0],
    "nominalIntervalMs": 180,
    "intervalJitter": 0.2,
    "windowMs": 120,
    "maxPerWindow": 2,
    "maxPerSecond": 6
  },
  "dieBoom": {
    "staggerMs": 80,
    "skipBoomOnLethal": true
  },
  "attackSfx": {
    "maxGapToImpactSec": 0.18,
    "immediateStyles": ["bow", "charge"]
  }
}

    "order": [
      "lookup delta",
      "personality multiplier (only one personality per general)",
      "round half away from zero",
      "clamp to range",
      "per-season cap check",
      "cooldown check",
      "friendship.add"
    ],
    "roundingRule": "half-away-from-zero",
    "personalityOnlyOne": true,

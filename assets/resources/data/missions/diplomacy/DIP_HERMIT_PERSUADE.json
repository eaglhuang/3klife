  "text": {
    "title": "遊說隱士出山",
    "brief": "山中有位隱士名聞一方，傳聞肯出山者可得一位良才。可他為什麼偏偏要隱居，沒人說得清。",
    "detail": "隱士居於深谷，三請不出，曾閉門拒絕數位太守。有人說他孤傲，有人說他另有苦衷。能不能請動他，全看你對他知道多少。"
  },
  "facts": [
    {
      "key": "temper",
      "label": "隱士脾性",
      "levels": [
        {
          "minIntel": 30,
          "text": "據說脾氣古怪，不愛俗事。"
        },
        {
          "minIntel": 60,
          "text": "最重禮數與學問，厭惡武夫與銅臭。"
        },
        {
          "minIntel": 90,
          "text": "隱居是因愛女病弱，若能請到良醫，他自會出山。"
        }
      ],
      "decoy": "聽說只要重金禮聘就能請動。"
    },
    {
      "key": "hidden_hook",
      "label": "隱情",
      "levels": [
        {
          "minIntel": 90,
          "text": "隱士之女仰慕俠義之士，或許能結下一段緣分。"
        }
      ]
    }
  ],

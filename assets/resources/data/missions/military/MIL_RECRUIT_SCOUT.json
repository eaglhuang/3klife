  "text": {
    "title": "收編烽燧哨探",
    "brief": "烽燧守卒舉薦了一位耳力過人的老哨探，只是他的來歷說不清楚。收不收他，得先去見他一面。",
    "detail": "老哨探常年獨居烽燧下的土屋，據說隔著十里就能聽出馬蹄的重量。守卒敬他、也怕他，卻沒人說得出他從哪裡來。"
  },
  "facts": [
    {
      "key": "past",
      "label": "過往",
      "levels": [
        {
          "minIntel": 30,
          "text": "他在邊地少說二十年，沒人說得清他吃過誰家的糧。"
        },
        {
          "minIntel": 60,
          "text": "他的左手少了兩指，問起時只笑不答。"
        }
      ],
      "decoy": "人人都說他是軍中老兵，忠心可靠。"
    },
    {
      "key": "manner",
      "label": "言行",
      "levels": [
        {
          "minIntel": 45,
          "text": "見到穿官服的人，他總要先看一眼對方的腰牌，再低頭。"
        }
      ]
    }
  ],

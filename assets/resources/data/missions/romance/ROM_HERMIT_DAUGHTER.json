  "text": {
    "title": "隱士之女",
    "brief": "隱士的女兒從不見外客，卻聽說過你的名字。這一面，見得好是一段緣，見得壞只是一場尷尬。",
    "detail": "深谷小院裡住著隱士唯一的女兒。有人說她愛讀書，有人說她夜裡練劍，也有人說她體弱不出門。誰也沒真正見過她，更沒人知道她想遇見什麼樣的人。"
  },
  "facts": [
    {
      "key": "maiden",
      "label": "其人",
      "levels": [
        {
          "minIntel": 30,
          "text": "是個從不出門的姑娘，院中偶有琴聲。"
        },
        {
          "minIntel": 60,
          "text": "窗下常有書聲，院裡卻偶有劍風，有時整夜咳聲不斷。"
        },
        {
          "minIntel": 90,
          "text": "她最在意的，是隱士身後那座日夜不熄的藥爐。"
        }
      ],
      "decoy": "聽說她愛慕虛榮，只要送上珠寶就能博得歡心。"
    }
  ],
  "requirement": {
    "slots": 1,

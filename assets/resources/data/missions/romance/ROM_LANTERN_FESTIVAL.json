      "key": "lady",
      "label": "佳人",
      "levels": [
        {
          "minIntel": 30,
          "text": "她始終沒有摘下面具，只是一次次回頭張望。"
        },
        {
          "minIntel": 60,
          "text": "她的指尖有墨痕，也有薄繭。"
        },
        {
          "minIntel": 90,
          "text": "她身邊的侍從，對每個靠近的人都先看腰間。"
        }
      ],
      "decoy": "她不過是尋常人家的女兒，不必多想。"
    }

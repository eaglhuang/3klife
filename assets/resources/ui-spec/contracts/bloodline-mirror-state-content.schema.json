{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaId": "bloodline-mirror-state-content",
  "familyId": "fullscreen-result",
  "version": 1,
  "description": "血脈命鏡 fullscreen-result 共用內容契約，對應 loading / awakening / ascension / unowned-preview / owned-legendary 五種 state。",
  "fields": {
    "stateBadgeLabel": {
      "type": "string",
      "required": true,
      "description": "頂部狀態徽章文字。",
      "bindPath": "MirrorChrome/StateBadgeRow/StateBadgeLabel"
    },
    "headerTitle": {
      "type": "string",
      "required": true,
      "description": "主標題文字。",
      "bindPath": "MirrorChrome/MirrorHeader/HeaderTitle"
    },
    "headerSubtitle": {
      "type": "string",
      "required": true,
      "description": "副標題文字。",
      "bindPath": "MirrorChrome/MirrorHeader/HeaderSubtitle"
    },
    "phaseLabel": {
      "type": "string",
      "required": true,
      "description": "階段資訊。",
      "bindPath": "MirrorChrome/MirrorMetaRow/PhaseLabel"
    },
    "rarityLabel": {
      "type": "string",
      "required": true,
      "description": "稀有度或星階資訊。",
      "bindPath": "MirrorChrome/MirrorMetaRow/RarityLabel"
    },
    "mirrorLabel": {
      "type": "string",
      "required": true,
      "description": "命鏡狀態資訊。",
      "bindPath": "MirrorChrome/MirrorMetaRow/MirrorLabel"
    },
    "crestLabel": {
      "type": "string",
      "required": true,
      "description": "命紋狀態資訊。",
      "bindPath": "MirrorChrome/MirrorMetaRow/CrestLabel"
    },
    "tipTitle": {
      "type": "string",
      "required": true,
      "description": "提示面板標題。",
      "bindPath": "MirrorStatePanels/TipPanelContent/TipTitle"
    },
    "tipBody": {
      "type": "string",
      "required": true,
      "description": "提示面板內文。",
      "bindPath": "MirrorStatePanels/TipPanelContent/TipBody"
    },
    "progressLabel": {
      "type": "string",
      "required": true,
      "description": "底部進度文字。",
      "bindPath": "MirrorStatePanels/ActionRow/ProgressLabel"
    },
    "primaryActionLabel": {
      "type": "string",
      "required": true,
      "description": "主操作按鈕文字。",
      "bindPath": "MirrorStatePanels/ActionRow/PrimaryActionButton/PrimaryActionLabel"
    },
    "crestState": {
      "type": "string",
      "required": true,
      "description": "命紋內容狀態。",
      "enum": ["placeholder", "rumored", "revealed", "awakened"],
      "bindPath": "CenterStage/CrestBadge"
    },
    "storyCells": {
      "type": "object",
      "required": true,
      "description": "五格故事帶內容。",
      "bindPath": "StoryStrip"
    },
    "showPrimaryAction": {
      "type": "boolean",
      "required": false,
      "description": "主操作按鈕是否顯示（BMV3-02 state 差異）。",
      "bindPath": "MirrorStatePanels/ActionRow/PrimaryActionButton"
    },
    "showTips": {
      "type": "boolean",
      "required": false,
      "description": "提示面板是否顯示。",
      "bindPath": "MirrorStatePanels/TipPanel"
    },
    "spiritBrightness": {
      "type": "string",
      "enum": ["dim", "normal", "bright"],
      "required": false,
      "description": "右側英靈亮度。",
      "bindPath": "SpiritHero",
      "nodeVisual": { "opacity": { "dim": 110, "normal": 190, "bright": 255 } }
    },
    "auraColor": {
      "type": "string",
      "enum": ["gold", "purple", "blue", "silver"],
      "required": false,
      "description": "定心者 aura 色（金傳說／紫史詩／藍稀有／銀白低階或未完整覺醒）。",
      "bindPath": "CenterStage/VesselCore",
      "nodeVisual": { "spriteColor": { "gold": "#FFC107", "purple": "#9C27B0", "blue": "#2196F3", "silver": "#E0E0E0" } }
    },
    "showLockBadge": {
      "type": "boolean",
      "required": false,
      "description": "未持有鎖定標記是否顯示。",
      "bindPath": "UnownedVeil"
    }
  },
  "requiredFields": [
    "stateBadgeLabel",
    "headerTitle",
    "headerSubtitle",
    "phaseLabel",
    "rarityLabel",
    "mirrorLabel",
    "crestLabel",
    "tipTitle",
    "tipBody",
    "progressLabel",
    "primaryActionLabel",
    "crestState",
    "storyCells"
  ]
}

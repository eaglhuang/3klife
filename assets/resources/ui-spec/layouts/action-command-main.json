{
  "id": "action-command-main",
  "version": 3,
  "_doc": "B1 (PROG-2-10133)：指令座 360×156——左側奧義環（按鈕 128＋環外擴 10 = 148），右側上排計謀 84×72＋出陣 108×72，下排結束回合 200×76。結束回合（朱漆）與出陣（金漆）為主要鈕；外觀由 BattleButtonStyle 繪製。",
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "designWidth": 1920,
    "designHeight": 1080,
    "safeAreaConstrained": true
  },
  "root": {
    "type": "container",
    "name": "ActionCommandRoot",
    "widget": {
      "bottom": 20,
      "right": 12
    },
    "width": 360,
    "height": 156,
    "children": [
      {
        "type": "button",
        "name": "EndTurnBtn",
        "id": "endTurnBtn",
        "widget": {
          "right": 0,
          "bottom": 0
        },
        "width": 200,
        "height": 76,
        "skinSlot": "action.btn.hit",
        "_doc": "主要回合操作：可讀文字與完整點擊區；不再縮成待機圖示。",
        "children": [
          {
            "type": "label",
            "name": "EndTurnLabel",
            "widget": {
              "left": 8,
              "right": 8,
              "top": 8,
              "bottom": 8
            },
            "width": 184,
            "height": 60,
            "textKey": "battle.end_turn",
            "text": "結束回合",
            "styleSlot": "action.util.endturn.label"
          }
        ]
      },
      {
        "type": "button",
        "name": "UltimateBtn",
        "id": "ultimateBtn",
        "widget": {
          "left": 14,
          "bottom": 14
        },
        "width": 128,
        "height": 128,
        "skinSlot": "action.ultimate.bg",
        "_doc": "奧義主按鈕，保留為群組裡最大主操作圓盤。",
        "children": [
          {
            "type": "image",
            "name": "SpRing",
            "id": "spRing",
            "widget": {
              "top": -10,
              "bottom": -10,
              "left": -10,
              "right": -10
            },
            "skinSlot": "action.sp.ring",
            "_doc": "SP填充環（8px寬圓環）。TS透過 Sprite.fillRange(0.0~1.0) 控制，順時針填充。滿SP切換skin→action.sp.ring.ready"
          },
          {
            "type": "label",
            "name": "UltLabel",
            "id": "ultLabel",
            "width": 112,
            "height": 36,
            "styleSlot": "action.ultimate.label",
            "bind": "battle.ultName",
            "_doc": "SP未滿顯示'奧義'；SP滿顯示'發動'",
            "widget": {
              "top": 26,
              "left": 8,
              "right": 8
            }
          },
          {
            "type": "label",
            "name": "SpPctLabel",
            "id": "spPctLabel",
            "width": 112,
            "height": 28,
            "styleSlot": "action.sp.pct.label",
            "bind": "battle.spPct",
            "_doc": "顯示'SP 75%'，SP滿時隱藏",
            "widget": {
              "top": 66,
              "left": 8,
              "right": 8
            }
          }
        ]
      },
      {
        "type": "button",
        "name": "TacticsBtn",
        "id": "tacticsBtn",
        "widget": {
          "right": 116,
          "top": 0
        },
        "width": 84,
        "height": 72,
        "skinSlot": "action.btn.hit",
        "_doc": "中頻操作 1：計謀，配置於主按鈕右側。",
        "children": [
          {
            "type": "label",
            "name": "TacticsLabel",
            "widget": {
              "left": 4,
              "right": 4,
              "top": 6,
              "bottom": 6
            },
            "width": 76,
            "height": 60,
            "text": "計謀",
            "textKey": "battle.tactics",
            "styleSlot": "action.util.label"
          }
        ]
      },
      {
        "type": "button",
        "name": "DuelBtn",
        "id": "duelBtn",
        "widget": {
          "right": 0,
          "top": 0
        },
        "width": 108,
        "height": 72,
        "skinSlot": "action.btn.hit",
        "_doc": "中頻操作 2：單挑，與計謀共同形成主按鈕右側雙次鍵。",
        "children": [
          {
            "type": "label",
            "name": "DuelLabel",
            "widget": {
              "left": 4,
              "right": 4,
              "top": 6,
              "bottom": 6
            },
            "width": 100,
            "height": 60,
            "textKey": "battle.sortie",
            "text": "出陣",
            "styleSlot": "action.util.label"
          }
        ]
      },
      {
        "type": "container",
        "name": "UltimatePopup",
        "id": "ultimatePopup",
        "widget": {
          "left": 8,
          "bottom": 146
        },
        "width": 220,
        "height": 0,
        "skinSlot": "action.popup.bg",
        "active": false,
        "_doc": "奧義技能選擇彈窗。SP滿時點擊大圓觸發 → active:true + Tween高度展開(技能數×56+16)。點擊外部關閉。",
        "children": []
      }
    ]
  },
  "interactions": {
    "_doc": "TS實作參考",
    "onEndTurnClick": "ActionCommandPanel.ts 監聽 EndTurnBtn.click → emit endTurn 事件（BattleScene 接收）",
    "onTacticsClick": "ActionCommandPanel.ts 監聽 TacticsBtn.click → emit tactics 事件",
    "onDuelClick": "ActionCommandPanel.ts 監聽 DuelBtn.click → emit GeneralDuelChallenge 全域事件",
    "spUpdate": "BattleManager 廣播 SP_CHANGED → ActionCommandPanel 更新 spRing 填充值、ultLabel 文字",
    "onUltimateClick": "SP>=100% → 開啟 UltimatePopup（由TS動態填充技能項目）；SP<100% → toast '奧義蓄力中'"
  }
}

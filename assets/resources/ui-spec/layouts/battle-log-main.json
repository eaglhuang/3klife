{
  "id": "battle-log-main",
  "version": 3,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "designWidth": 1920,
    "designHeight": 1080,
    "safeAreaConstrained": true
  },
  "root": {
    "type": "container",
    "name": "SidePanelRoot",
    "width": 344,
    "widget": {
      "right": 16,
      "top": 184
    },
    "layout": {
      "type": "vertical",
      "spacing": 0
    },
    "children": [
      {
        "type": "panel",
        "name": "ControlBar",
        "width": "100%",
        "height": 80,
        "skinSlot": "log.header.bg",
        "layout": {
          "type": "horizontal",
          "spacing": 8,
          "paddingLeft": 8,
          "paddingRight": 8
        },
        "children": [
          {
            "type": "button",
            "name": "BtnAuto",
            "id": "btnAuto",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.auto",
            "children": [
              {
                "type": "image",
                "name": "AutoIcon",
                "id": "autoIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.auto",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnDelegate",
            "id": "btnDelegate",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.auto",
            "children": [
              {
                "type": "label",
                "name": "DelegateText",
                "id": "delegateText",
                "width": 72,
                "height": 72,
                "text": "委",
                "styleSlot": "log.label.title",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                }
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnSpeed",
            "id": "btnSpeed",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.speed",
            "children": [
              {
                "type": "image",
                "name": "SpeedIcon",
                "id": "speedIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.speed",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnSetting",
            "id": "btnSetting",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.setting",
            "children": [
              {
                "type": "image",
                "name": "SettingIcon",
                "id": "settingIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.setting",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          }
        ]
      },
      {
        "type": "panel",
        "name": "BattleLogPanel",
        "id": "battleLogPanel",
        "width": "100%",
        "height": 280,
        "skinSlot": "log.root.bg",
        "layout": {
          "type": "vertical",
          "spacing": 0
        },
        "children": [
          {
            "type": "panel",
            "name": "Header",
            "width": "100%",
            "height": 44,
            "skinSlot": "log.header.bg",
            "layout": {
              "type": "horizontal",
              "spacing": 8,
              "paddingLeft": 12,
              "paddingRight": 12
            },
            "children": [
              {
                "type": "label",
                "name": "Title",
                "id": "logTitle",
                "width": 140,
                "height": 36,
                "text": "戰鬥日誌",
                "styleSlot": "log.label.title"
              }
            ]
          },
          {
            "type": "scroll-view",
            "name": "ScrollView",
            "id": "scrollView",
            "width": "100%",
            "height": 236,
            "children": [
              {
                "type": "container",
                "name": "ContentNode",
                "id": "contentNode",
                "width": "100%",
                "height": 340,
                "children": [
                  {
                    "type": "label",
                    "name": "LogLabel",
                    "id": "logLabel",
                    "width": "100%",
                    "height": 340,
                    "styleSlot": "log.label.content",
                    "bind": "battleLog.message"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "name": "BtnCollapse",
        "id": "btnCollapse",
        "width": "100%",
        "height": 72,
        "text": "戰報",
        "skinSlot": "log.btn.collapse",
        "styleSlot": "log.label.toggle",
        "children": [
          {
            "type": "image",
            "name": "CollapseIcon",
            "id": "collapseIcon",
            "widget": {
              "right": 16,
              "vCenter": true
            },
            "width": 12,
            "height": 12,
            "skinSlot": "log.icon.collapse",
            "_doc": "F8 tactical control overlay glyph"
          }
        ],
        "_comment": "Collapse only hides the log body; control touch targets remain full size."
      }
    ]
  }
}

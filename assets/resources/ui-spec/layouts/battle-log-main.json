{
  "id": "battle-log-main",
  "version": 5,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "designWidth": 1920,
    "designHeight": 1080,
    "safeAreaConstrained": true
  },
  "root": {
    "type": "container",
    "name": "SidePanelRoot",
    "width": 72,
    "widget": {
      "right": 16,
      "top": 320
    },
    "children": [
      {
        "type": "panel",
        "name": "ControlBar",
        "width": 72,
        "height": 392,
        "skinSlot": "log.header.bg",
        "layout": {
          "type": "vertical",
          "spacing": 8
        },
        "children": [
          {
            "type": "button",
            "name": "BtnAuto",
            "id": "btnAuto",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.auto",
            "children": [
              {
                "type": "image",
                "name": "AutoIcon",
                "id": "autoIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.auto",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnDelegate",
            "id": "btnDelegate",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.auto",
            "children": [
              {
                "type": "label",
                "name": "DelegateText",
                "id": "delegateText",
                "width": 72,
                "height": 72,
                "text": "委任",
                "styleSlot": "log.label.btn",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "textKey": "battle.log.delegate"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnSpeed",
            "id": "btnSpeed",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.speed",
            "children": [
              {
                "type": "image",
                "name": "SpeedIcon",
                "id": "speedIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.speed",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnSetting",
            "id": "btnSetting",
            "width": 72,
            "height": 72,
            "skinSlot": "log.btn.setting",
            "children": [
              {
                "type": "image",
                "name": "SettingIcon",
                "id": "settingIcon",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                },
                "width": 32,
                "height": 32,
                "skinSlot": "log.icon.setting",
                "_doc": "F8 tactical control overlay glyph"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnCollapse",
            "id": "btnCollapse",
            "width": 72,
            "height": 72,
            "text": "戰報",
            "skinSlot": "log.btn.collapse",
            "styleSlot": "log.label.toggle",
            "children": [
              {
                "type": "image",
                "name": "CollapseIcon",
                "id": "collapseIcon",
                "widget": {
                  "hCenter": true,
                  "bottom": 6
                },
                "width": 12,
                "height": 12,
                "skinSlot": "log.icon.collapse",
                "_doc": "F8 tactical control overlay glyph"
              }
            ],
            "_comment": "Collapse only hides the log body; control touch targets remain full size.",
            "textKey": "battle.log.toggle"
          }
        ],
        "widget": {
          "right": 0,
          "top": 0
        }
      },
      {
        "type": "panel",
        "name": "BattleLogPanel",
        "id": "battleLogPanel",
        "width": 280,
        "height": 216,
        "skinSlot": "log.root.bg",
        "layout": {
          "type": "vertical",
          "spacing": 0
        },
        "children": [
          {
            "type": "panel",
            "name": "Header",
            "width": "100%",
            "height": 44,
            "skinSlot": "log.header.bg",
            "layout": {
              "type": "horizontal",
              "spacing": 8,
              "paddingLeft": 12,
              "paddingRight": 12
            },
            "children": [
              {
                "type": "label",
                "name": "Title",
                "id": "logTitle",
                "width": 140,
                "height": 36,
                "text": "戰鬥日誌",
                "styleSlot": "log.label.title",
                "textKey": "battle.log.title"
              }
            ]
          },
          {
            "type": "scroll-view",
            "name": "ScrollView",
            "id": "scrollView",
            "width": "100%",
            "height": 172,
            "children": [
              {
                "type": "container",
                "name": "ContentNode",
                "id": "contentNode",
                "width": "100%",
                "height": 164,
                "children": [
                  {
                    "type": "label",
                    "name": "LogLabel",
                    "id": "logLabel",
                    "width": "100%",
                    "height": 164,
                    "styleSlot": "log.label.content",
                    "bind": "battleLog.message"
                  }
                ]
              }
            ]
          }
        ],
        "widget": {
          "right": 352,
          "top": 534
        }
      }
    ],
    "height": 392,
    "_comment": "PROG-2-9377: 5 buttons stacked on the right edge; the log body opens to the left of the column so the two right-most board columns stay visible while collapsed. PROG-2-9389: the log body now opens below the board (bottom-right gap, left of the SP panel) so it never covers the enemy general or the two right-most board columns."
  }
}

        "children": [
          {
            "type": "panel",
            "name": "Header",
            "width": "100%",
            "height": 44,
            "skinSlot": "log.header.bg",
            "layout": {
              "type": "horizontal",
              "spacing": 8,
              "paddingLeft": 12,
              "paddingRight": 12

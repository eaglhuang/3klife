{
  "id": "battle-review-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "safeAreaConstrained": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "BattleReviewRoot",
    "id": "battleReviewRoot",
    "width": 1920,
    "height": 1080,
    "children": [
      {
        "type": "panel",
        "name": "BattleReviewCard",
        "id": "battleReviewCard",
        "width": 1000,
        "height": 860,
        "skinSlot": "br.card.bg",
        "layout": {
          "type": "vertical",
          "justifyContent": "start",
          "spacingY": 12,
          "paddingTop": 28,
          "paddingRight": 28,
          "paddingBottom": 28,
          "paddingLeft": 28
        },
        "children": [
          {
            "type": "label",
            "name": "ReviewTitle",
            "id": "reviewTitle",
            "width": 944,
            "height": 48,
            "text": "戰報",
            "styleSlot": "br.label.title"
          },
          {
            "type": "container",
            "name": "ReviewNavRow",
            "id": "reviewNavRow",
            "width": 944,
            "height": 64,
            "children": [
              {
                "type": "button",
                "name": "BtnPrevPage",
                "id": "btnPrevPage",
                "width": 160,
                "height": 64,
                "skinSlot": "br.button.bg",
                "children": [
                  {
                    "type": "label",
                    "name": "BtnPrevPageLabel",
                    "id": "btnPrevPageLabel",
                    "width": 160,
                    "height": 40,
                    "text": "◀ 上一頁",
                    "styleSlot": "br.label.body"
                  }
                ],
                "widget": {
                  "left": 0,
                  "vCenter": true
                }
              },
              {
                "type": "label",
                "name": "ReviewPageLabel",
                "id": "reviewPageLabel",
                "width": 400,
                "height": 40,
                "text": "",
                "styleSlot": "br.label.body",
                "widget": {
                  "hCenter": true,
                  "vCenter": true
                }
              },
              {
                "type": "button",
                "name": "BtnNextPage",
                "id": "btnNextPage",
                "width": 160,
                "height": 64,
                "skinSlot": "br.button.bg",
                "children": [
                  {
                    "type": "label",
                    "name": "BtnNextPageLabel",
                    "id": "btnNextPageLabel",
                    "width": 160,
                    "height": 40,
                    "text": "下一頁 ▶",
                    "styleSlot": "br.label.body"
                  }

{
  "id": "extreme-task-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "safeAreaConstrained": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "ExtremeTaskRoot",
    "id": "extremeTaskRoot",
    "width": 1920,
    "height": 1080,
    "children": [
      {
        "type": "panel",
        "name": "ExtremeTaskCard",
        "id": "extremeTaskCard",
        "width": 800,
        "height": 440,
        "skinSlot": "et.card.bg",
        "layout": {
          "type": "vertical",
          "justifyContent": "start",
          "spacingY": 12,
          "paddingTop": 28,
          "paddingRight": 28,
          "paddingBottom": 28,
          "paddingLeft": 28
        },
        "children": [
          {
            "type": "label",
            "name": "EtTitle",
            "id": "etTitle",
            "width": 744,
            "height": 48,
            "text": "天下征鋒",
            "styleSlot": "et.label.title"
          },
          {
            "type": "label",
            "name": "EtBossLabel",
            "id": "etBossLabel",
            "width": 744,
            "height": 40,
            "text": "本週 BOSS：",
            "styleSlot": "et.label.body"
          },
          {
            "type": "label",
            "name": "EtQuotaLabel",
            "id": "etQuotaLabel",
            "width": 744,
            "height": 40,
            "text": "本週免費次數：",
            "styleSlot": "et.label.body"
          },
          {
            "type": "label",
            "name": "EtOrderLabel",
            "id": "etOrderLabel",
            "width": 744,
            "height": 40,
            "text": "極限挑戰令：",
            "styleSlot": "et.label.body"
          },
          {
            "type": "label",
            "name": "EtRuleLabel",
            "id": "etRuleLabel",
            "width": 744,
            "height": 40,
            "text": "開戰即扣次數；通關後回大廳領取掉落。",
            "styleSlot": "et.label.body"
          },
          {
            "type": "label",
            "name": "EtMessageLabel",
            "id": "etMessageLabel",
            "width": 744,
            "height": 40,
            "text": "",
            "styleSlot": "et.label.body"
          },
          {
            "type": "container",
            "name": "EtButtonRow",
            "id": "etButtonRow",
            "width": 744,
            "height": 64,
            "children": [
              {
                "type": "button",
                "name": "BtnChallenge",
                "id": "btnChallenge",
                "width": 200,
                "height": 64,
                "skinSlot": "et.button.bg",
                "children": [
                  {
                    "type": "label",
                    "name": "BtnChallengeLabel",
                    "id": "btnChallengeLabel",
                    "width": 200,
                    "height": 40,
                    "text": "挑戰",
                    "styleSlot": "et.label.body"
                  }
                ],
                "widget": {
                  "left": 0,
                  "vCenter": true
                }
              },
              {
                "type": "button",
                "name": "BtnClose",
                "id": "btnClose",
                "width": 200,
                "height": 64,
                "skinSlot": "et.button.bg",
                "children": [
                  {
                    "type": "label",
                    "name": "BtnCloseLabel",
                    "id": "btnCloseLabel",
                    "width": 200,
                    "height": 40,
                    "text": "關閉",
                    "styleSlot": "et.label.body"
                  }
                ],
                "widget": {
                  "right": 0,
                  "vCenter": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}

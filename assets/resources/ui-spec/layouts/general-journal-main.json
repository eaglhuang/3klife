{
  "id": "general-journal-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "safeAreaConstrained": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "GeneralJournalRoot",
    "id": "generalJournalRoot",
    "width": 1920,
    "height": 1080,
    "children": [
      {
        "type": "panel",
        "name": "GeneralJournalCard",
        "id": "generalJournalCard",
        "width": 1000,
        "height": 820,
        "skinSlot": "gj.card.bg",
        "layout": {
          "type": "vertical",
          "justifyContent": "start",
          "spacingY": 12,
          "paddingTop": 28,
          "paddingRight": 28,
          "paddingBottom": 28,
          "paddingLeft": 28
        },
        "children": [
          {
            "type": "label",
            "name": "JournalTitle",
            "id": "journalTitle",
            "width": 944,
            "height": 48,
            "text": "武將日誌",
            "styleSlot": "gj.label.title"
          },
          {
            "type": "container",
            "name": "JournalNavRow",
            "id": "journalNavRow",
            "width": 944,
            "height": 64,
            "children": [
              {
                "type": "button",
                "name": "BtnPrevGeneral",
                "id": "btnPrevGeneral",
                "width": 160,
                "height": 64,
                "skinSlot": "gj.button.bg",

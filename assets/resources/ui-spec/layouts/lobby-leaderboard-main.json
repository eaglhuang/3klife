{
  "id": "lobby-leaderboard-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "safeAreaConstrained": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "LobbyLeaderboardRoot",
    "widget": {
      "top": 0,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "transition": {
      "enter": "scaleIn",
      "exit": "scaleOut",
      "duration": 0.22,
      "easing": "backOut"
    },
    "children": [
      {
        "type": "button",
        "name": "OverlayMask",
        "id": "overlayMask",
        "widget": {
          "top": 0,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "skinSlot": "leaderboard.overlay.mask",
        "onClick": "onClose"
      },
      {
        "type": "panel",
        "name": "DialogCard",
        "widget": {
          "hCenter": 0,
          "vCenter": 0
        },
        "width": 800,
        "height": 900,
        "skinSlot": "leaderboard.card.bg",
        "layout": {
          "type": "vertical",
          "spacing": 0,
          "paddingTop": 0,
          "paddingBottom": 0,
          "paddingLeft": 0,
          "paddingRight": 0

                "type": "button",
                "name": "BtnClose",
                "id": "btnClose",
                "width": 56,
                "height": 56,
                "skinSlot": "leaderboard.close.btn",
                "onClick": "onClose",
                "children": [
                  {
                    "type": "label",
                    "name": "CloseLabel",
                    "width": "100%",
                    "height": "100%",
                    "skinSlot": "leaderboard.text.primary",
                    "text": "X"
                  }
                ]
              }
            ]
          },
          {
            "type": "panel",
            "name": "MetricRow",
            "width": "100%",
            "height": 80,

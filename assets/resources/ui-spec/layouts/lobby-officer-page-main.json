{
  "id": "lobby-officer-page-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "safeAreaConstrained": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "LobbyOfficerPageRoot",
    "widget": {
      "top": 0,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "children": [
      {
        "type": "panel",
        "name": "OfficerPageCard",
        "widget": {
          "top": 160,
          "left": 32
        },
        "width": 520,
        "height": 440,
        "skinSlot": "officer.page.card.bg",
        "children": [
          {
            "type": "label",
            "name": "OfficerPageTitleLabel",
            "id": "officerPageTitle",
            "widget": {
              "top": 12,
              "left": 16,
              "right": 16
            },
            "height": 34,
            "text": "官職詳情",
            "styleSlot": "officer.page.label.title"
          },
          {
            "type": "label",
            "name": "OfficerPermissionLabel",
            "id": "officerPermissionText",
            "widget": {
              "top": 60,
              "left": 16,
              "right": 16
            },
            "height": 300,
            "text": "",
            "styleSlot": "officer.page.label.body"
          },
          {
            "type": "button",
            "name": "CloseOfficerPageButton",
            "id": "btnCloseOfficerPage",
            "widget": {
              "bottom": 12,
              "left": 16,
              "right": 16
            },
            "height": 44,
            "skinSlot": "officer.page.button.bg",
            "children": [
              {
                "type": "label",
                "name": "CloseOfficerPageLabel",
                "id": "closeOfficerPageLabel",
                "widget": {
                  "vCenter": true,
                  "left": 0,
                  "right": 0
                },
                "height": 24,
                "text": "關閉",
                "styleSlot": "officer.page.label.button"
              }
            ]
          }
        ]
      }

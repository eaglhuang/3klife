            "width": 4,
            "skinSlot": "tutorial.button.confirm.bg"
          },
          {
            "type": "label",
            "name": "TutorialPointer",
            "id": "tutorialPointer",
            "widget": {
              "bottom": -44,
              "hCenter": true
            },
            "width": 600,
            "height": 40,
            "text": "▲ 操作此處",
            "styleSlot": "tutorial.label.title"
          }

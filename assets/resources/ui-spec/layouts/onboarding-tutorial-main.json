            "height": 4,
            "skinSlot": "tutorial.button.confirm.bg"
          },
          {
            "type": "panel",
            "name": "HighlightBottom",
            "widget": {
              "bottom": 0,
              "left": 0,
              "right": 0
            },
            "height": 4,
            "skinSlot": "tutorial.button.confirm.bg"
          },
          {
            "type": "panel",
            "name": "HighlightLeft",
            "widget": {
              "top": 0,
              "bottom": 0,
              "left": 0

            "width": 240,
            "height": 64,
            "skinSlot": "tutorial.button.confirm.bg",
            "children": [
              {
                "type": "label",
                "name": "BtnNextTutorialLabel",
                "id": "btnNextTutorialLabel",
                "widget": {
                  "vCenter": true,
                  "left": 0,
                  "right": 0
                },
                "height": 56,
                "text": "下一步",
                "styleSlot": "tutorial.label.button"
              }
            ]
          },
          {
            "type": "label",
            "name": "TutorialAction",
            "id": "tutorialAction",
            "widget": {
              "top": 184,
              "left": 48,
              "right": 48
            },
            "height": 112,
            "text": "",
            "styleSlot": "tutorial.label.body"
          }
        ]
      },
      {
        "type": "container",
        "name": "TutorialHighlight",
        "id": "tutorialHighlight",
        "active": false,
        "width": 240,
        "height": 88,
        "children": [
          {
            "type": "panel",
            "name": "HighlightTop",
            "widget": {
              "top": 0,
              "left": 0,
              "right": 0

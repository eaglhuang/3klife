            "height": 32,
            "text": "",
            "styleSlot": "tutorial.label.meta",
            "width": 300
          },
          {
            "type": "label",
            "name": "TutorialText",
            "id": "tutorialText",
            "widget": {
              "top": 90,
              "left": 48,
              "right": 48
            },
            "height": 80,
            "text": "",
            "styleSlot": "tutorial.label.body"
          },
          {
            "type": "button",
            "name": "BtnNextTutorial",
            "id": "btnNextTutorial",
            "widget": {
              "bottom": 28,
              "hCenter": true

{
  "id": "result-popup-main",
  "version": 1,
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "ResultPopupRoot",
    "widget": {
      "top": 0,
      "left": 0,
      "right": 0,
      "bottom": 0
    },
    "transition": {
      "enter": "fadeIn",
      "exit": "fadeOut",
      "duration": 0.25
    },
    "children": [
      {
        "type": "panel",
        "name": "Overlay",
        "widget": {
          "top": 0,
          "left": 0,
          "right": 0,
          "bottom": 0
        },
        "skinSlot": "popup.overlay"
      },
      {
        "type": "panel",
        "name": "Card",
        "id": "card",
        "width": 1120,
        "height": 880,
        "skinSlot": "popup.card.bg",
        "layout": {
          "type": "vertical",
          "spacing": 12,
          "paddingTop": 36,
          "paddingBottom": 32,
          "paddingLeft": 56,
          "paddingRight": 56
        },
        "children": [
          {
            "type": "container",
            "name": "HeaderRow",
            "id": "headerRow",
            "width": "100%",
            "height": 176,
            "layout": {
              "type": "horizontal",
              "spacing": 32
            },
            "children": [
              {
                "type": "panel",
                "name": "AvatarRing",
                "id": "avatarRing",
                "width": 168,
                "height": 168,
                "skinSlot": "popup.avatar.ring",
                "children": [
                  {
                    "type": "container",
                    "name": "AvatarMask",
                    "id": "avatarMask",
                    "widget": {
                      "hCenter": true,
                      "vCenter": true
                    },
                    "width": 156,
                    "height": 156,
                    "children": [
                      {
                        "type": "image",
                        "name": "Avatar",
                        "id": "avatar",
                        "width": 156,
                        "height": 156,
                        "skinSlot": "popup.avatar"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "container",
                "name": "HeaderText",
                "id": "headerText",
                "width": 808,
                "height": 176,
                "layout": {
                  "type": "vertical",
                  "spacing": 4,
                  "paddingTop": 4
                },
                "children": [
                  {
                    "type": "label",
                    "name": "TitleLabel",
                    "id": "titleLabel",
                    "width": "100%",
                    "height": 72,
                    "textKey": "ui.result.victory",
                    "styleSlot": "popup.label.title"
                  },
                  {
                    "type": "label",
                    "name": "DescLabel",
                    "id": "descLabel",
                    "width": "100%",
                    "height": 96,
                    "textKey": "ui.result.title",
                    "styleSlot": "popup.label.verdict"
                  }
                ]
              }
            ]
          },
          {
            "type": "scroll-view",
            "name": "DetailScroll",
            "id": "detailScroll",
            "width": "100%",
            "height": 520,
            "layout": {
              "type": "vertical",
              "spacing": 6,
              "paddingTop": 4,
              "paddingBottom": 12
            },
            "_comment": "結算明細分區列（PROG-2-9424）：ResultPopupComposite 依 ResultDetailSections 動態產生區段標題與鍵值列",
            "skinSlot": "popup.detail.bg",
            "scrollbar": {
              "width": 10,
              "right": 6,
              "top": 12,
              "bottom": 12,
              "trackSkinSlot": "popup.scrollbar.track",
              "thumbSkinSlot": "popup.scrollbar.thumb",
              "autoHide": false
            }
          },
          {
            "type": "container",
            "name": "ButtonRow",
            "width": "100%",
            "height": 72,
            "layout": {
              "type": "horizontal",
              "spacing": 16
            },
            "children": [
              {
                "type": "button",
                "name": "BtnBack",
                "id": "btnBack",
                "width": "48%",
                "height": 72,
                "skinSlot": "common.button.secondary",
                "textKey": "ui.result.back_to_lobby",
                "onClick": "onClickBack"
              },
              {
                "type": "button",
                "name": "BtnReplay",
                "id": "btnReplay",
                "width": "48%",
                "height": 72,
                "skinSlot": "common.button.primary",
                "textKey": "ui.result.retry",
                "onClick": "onClickReplay"
              }
            ]
          }
        ]
      }
    ]
  }
}

{
  "id": "turn-banner-main",
  "version": 1,
  "canvas": { "fitWidth": true, "fitHeight": true, "safeArea": true, "designWidth": 1920, "designHeight": 1080 },
  "root": {
    "type": "panel",
    "name": "TurnBannerRoot",
    "width": 1920,
    "height": 132,
    "widget": { "vCenter": true, "left": 0, "right": 0 },
    "skinSlot": "turnBanner.bg",
    "transition": { "enter": "fadeIn", "exit": "fadeOut", "duration": 0.2 },
    "children": [
      {
        "type": "label",
        "name": "BannerText",
        "width": 1200,
        "height": 112,
        "widget": { "hCenter": 0, "vCenter": 0 },
        "bind": "bannerText",
        "styleSlot": "turnBanner.label"
      }
    ]
  }
}

{
  "id": "unit-info-panel-main",
  "version": 2,
  "_doc": "短按虎符卡後出現的兵種資訊小面板。位置：虎符卡與軍師列右側、棋盤左上方的空地（left 290, top 84），380x300，不蓋虎符卡也不蓋棋盤可出陣的格子。內文是一段會換行的文字，太長就捲動（PROG-2-9390）。",
  "canvas": {
    "fitWidth": true,
    "fitHeight": true,
    "safeArea": true,
    "designWidth": 1920,
    "designHeight": 1080
  },
  "root": {
    "type": "container",
    "name": "UnitInfoPanelRoot",
    "id": "unitInfoPanelRoot",
    "widget": {
      "top": 84,
      "left": 290
    },
    "width": 380,
    "skinSlot": "unitinfo.root.bg",
    "transition": {
      "enter": "fadeIn",
      "exit": "fadeOut",
      "duration": 0.2
    },
    "children": [
      {
        "type": "panel",
        "name": "Header",
        "widget": {
          "top": 0,
          "left": 0,
          "right": 0
        },
        "width": "100%",
        "height": 76,
        "skinSlot": "unitinfo.header.bg",
        "layout": {
          "type": "horizontal",
          "spacing": 8,
          "paddingLeft": 12,
          "paddingRight": 10,
          "paddingTop": 0,
          "paddingBottom": 0
        },
        "children": [
          {
            "type": "image",
            "name": "TypeIcon",
            "id": "typeIcon",
            "width": 48,
            "height": 48,
            "skinSlot": "unitinfo.type.icon",
            "_doc": "兵種符號圓形icon，border-color由TS根據兵種設定"
          },
          {
            "type": "panel",
            "name": "TitleGroup",
            "flex": 1,
            "height": 66,
            "layout": {
              "type": "vertical",
              "spacing": 2
            },
            "children": [
              {
                "type": "label",
                "name": "UnitName",
                "id": "unitName",
                "width": "100%",
                "height": 34,
                "styleSlot": "unitinfo.label.name",
                "bind": "unit.name"
              },
              {
                "type": "label",
                "name": "UnitSub",
                "id": "unitSub",
                "width": "100%",
                "height": 30,
                "styleSlot": "unitinfo.label.sub",
                "bind": "unit.unitSub"
              }
            ]
          },
          {
            "type": "button",
            "name": "BtnClose",
            "id": "btnClose",
            "width": 44,
            "height": 44,
            "skinSlot": "unitinfo.btn.close",
            "_doc": "點擊關閉面板"
          }
        ]
      },
      {
        "type": "scroll-view",
        "name": "ScrollView",
        "id": "scrollView",
        "width": "100%",
        "height": 216,
        "widget": {
          "top": 80,
          "left": 0,
          "right": 0
        },
        "children": [
          {
            "type": "container",
            "name": "ContentNode",
            "id": "contentNode",
            "width": "100%",
            "height": 216,
            "children": [
              {
                "type": "label",
                "name": "BodyText",
                "id": "bodyText",
                "width": "100%",
                "height": 192,
                "styleSlot": "unitinfo.label.desc"
              }
            ]
          }
        ]
      }
    ],
    "height": 300
  }
}

{
  "id": "battle-log-default",
  "version": 3,
  "bundle": "battle_ui",
  "atlasPolicy": "battle_ui",
  "slots": {
    "log.root.bg": {
      "kind": "color",
      "color": "surfaceInkBlue",
      "alpha": 156
    },
    "log.header.bg": {
      "kind": "color",
      "color": "backgroundNavyAlt",
      "alpha": 188
    },
    "log.btn.toggle": {
      "kind": "color",
      "color": "secondary",
      "alpha": 200,
      "spriteType": "sliced",
      "border": [4, 4, 4, 4]
    },
    "log.label.title": {
      "kind": "label-style",
      "font": "fonts/newsreader/newsreader",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP",
      "horizontalAlign": "LEFT"
    },
    "log.label.toggle": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "textWarmGold",
      "horizontalAlign": "CENTER"
    },
    "log.label.content": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "textSteelLight",
      "overflow": "RESIZE_HEIGHT"
    },
    "log.label.btn": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "rarityWhite",
      "horizontalAlign": "CENTER"
    },
    "log.btn.hit": {
      "kind": "color",
      "color": "backgroundNavyAlt",
      "alpha": 0,
      "_doc": "全透明觸控範圍；外觀由 BattleButtonStyle 繪製（PROG-2-10133）"
    },
    "log.divider": {
      "kind": "color",
      "color": "secondary",
      "alpha": 170,
      "_doc": "頂欄功能群與退出鈕之間的分隔線（銅色）"
    }
  }
}

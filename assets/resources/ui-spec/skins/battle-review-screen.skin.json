{
  "id": "battle-review-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "br.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "br.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "br.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "br.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "br.label.line": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    }
  }
}

{
  "id": "daughter-route-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "dr.backdrop.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 200
    },
    "dr.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "dr.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "dr.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "dr.label.stats": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "dr.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "RESIZE_HEIGHT"
    },
    "dr.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "SHRINK",
      "isBold": true
    }
  }
}

{
  "id": "destiny-opening-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "do.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "do.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "do.row.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 200
    },
    "do.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "do.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "SHRINK"
    },
    "do.label.meta": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 26,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "do.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "do.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    }
  }
}

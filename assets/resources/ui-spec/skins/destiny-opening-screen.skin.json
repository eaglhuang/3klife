{
  "id": "destiny-opening-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "do.scrim": {
      "kind": "color-rect",
      "color": "#000000",
      "alpha": 170
    },
    "do.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "do.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "do.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "do.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "SHRINK"
    },
    "do.label.meta": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 26,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "do.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "do.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "pg.frame.bg": {
      "kind": "color-rect",
      "color": "#2E2422",
      "alpha": 255,
      "cornerRadius": 10,
      "borderWidth": 2,
      "borderColor": "#5A4C42"
    },
    "pg.portrait": {
      "kind": "sprite-frame",
      "path": "sprites/ui_avatars/unknown_avatar_f",
      "expectedWidth": 256,
      "expectedHeight": 256
    },
    "pg.plate": {
      "kind": "color-rect",
      "color": "#0A0808",
      "alpha": 200
    },
    "pg.sel": {
      "kind": "color-rect",
      "color": "#000000",
      "alpha": 0,
      "cornerRadius": 10,
      "borderWidth": 5,
      "borderColor": "#E8BE60"
    },
    "pg.label.name": {
      "kind": "label-style",
      "font": "fonts/notoserif_tc/notoserif_tc",
      "fontSize": 40,
      "lineHeight": 50,
      "color": "#F6E6C4",
      "isBold": true,
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER"
    },
    "pg.label.sub": {
      "kind": "label-style",
      "font": "fonts/notoserif_tc/notoserif_tc",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "#B4A08A",
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER"
    },
    "do.label.quote": {
      "kind": "label-style",
      "font": "fonts/notoserif_tc/notoserif_tc",
      "fontSize": 20,
      "lineHeight": 27,
      "color": "#E8D6B0",
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER",
      "verticalAlign": "TOP"
    }
  }
}

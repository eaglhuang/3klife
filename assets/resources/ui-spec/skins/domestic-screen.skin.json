{
  "id": "domestic-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "domestic.card.bg": {
      "kind": "color-rect",
      "color": "#140F0C",
      "alpha": 118,
      "cornerRadius": 4,
      "borderWidth": 1,
      "borderColor": "#E8C88CA0"
    },
    "domestic.button.bg": {
      "kind": "color-rect",
      "color": "#FFF0D7",
      "alpha": 20,
      "cornerRadius": 2,
      "borderWidth": 1,
      "borderColor": "#E8C88C70"
    },
    "domestic.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 40,
      "lineHeight": 52,
      "color": "#F6E7C3",
      "isBold": false,
      "overflow": "CLAMP",
      "letterSpacing": 12
    },
    "domestic.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "#B8A888",
      "isBold": false,
      "overflow": "SHRINK"
    },
    "domestic.label.meta": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 26,
      "color": "#A89470",
      "overflow": "SHRINK",
      "letterSpacing": 6
    },
    "domestic.label.log": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 28,
      "color": "#D9C9A6",
      "overflow": "SHRINK"
    },
    "domestic.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "#F1E5CC",
      "isBold": false,
      "overflow": "CLAMP",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "letterSpacing": 4
    },
    "domestic.backdrop": {
      "kind": "sprite-frame",
      "path": "sprites/ui_bg/domestic_bg",
      "expectedWidth": 1280,
      "expectedHeight": 720
    },
    "domestic.divider": {
      "kind": "color-rect",
      "color": "#E8C88C",
      "alpha": 110
    },
    "domestic.button.accent": {
      "kind": "color-rect",
      "color": "#A8322A",
      "alpha": 190,
      "cornerRadius": 2,
      "borderWidth": 1,
      "borderColor": "#F0B48C99"
    },
    "domestic.label.section": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 18,
      "lineHeight": 24,
      "letterSpacing": 8,
      "color": "#C4A05C",
      "overflow": "CLAMP"
    },
    "domestic.label.tile": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 28,
      "lineHeight": 36,
      "letterSpacing": 4,
      "color": "#F1E5CC",
      "overflow": "CLAMP",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER"
    }
  }
}

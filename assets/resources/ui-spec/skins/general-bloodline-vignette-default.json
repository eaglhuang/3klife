      "font": "fonts/notosans_tc/font",
      "fontSize": 18,
      "lineHeight": 26,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "vignette.label.cell": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "vignette.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",

{
  "id": "lineage-milestone-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "lineage.milestone.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 255
    },
    "lineage.milestone.row.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 180
    },
    "lineage.milestone.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 140
    },
    "lineage.milestone.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "lineage.milestone.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "lineage.milestone.label.note": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 18,
      "lineHeight": 26,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "lineage.milestone.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "lineage.milestone.backdrop.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 200
    }
  }
}

{
  "id": "lobby-deck-select-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "deck.select.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 224
    },
    "deck.select.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 140
    },
    "deck.select.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "deck.select.label.card": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    }
  }
}

{
  "id": "lobby-leaderboard-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "leaderboard.overlay.mask": {
      "kind": "sprite-frame",
      "path": "sprites/common/overlay_dark/spriteFrame",
      "spriteType": "sliced",
      "border": [
        1,
        1,
        1,
        1
      ],
      "allowAutoAtlas": false
    },
    "leaderboard.card.bg": {
      "kind": "sprite-frame",
      "path": "sprites/common/popup_card_bg/spriteFrame",
      "spriteType": "sliced",
      "border": [
        40,
        40,
        40,
        40
      ],
      "allowAutoAtlas": true
    },
    "leaderboard.header.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 252
    },
    "leaderboard.section.bg": {
      "kind": "color-rect",
      "color": "surfaceContainer",
      "alpha": 202
    },
    "leaderboard.scroll.bg": {
      "kind": "color-rect",
      "color": "background",
      "alpha": 194
    },
    "leaderboard.row.bg": {
      "kind": "color-rect",
      "color": "backgroundNavyAlt",
      "alpha": 170
    },
    "leaderboard.footer.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 224
    },
    "leaderboard.metric.btn": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 96
    },
    "leaderboard.close.btn": {
      "kind": "color-rect",
      "color": "surfaceContainer",
      "alpha": 220
    },
    "leaderboard.text.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 34,
      "lineHeight": 40,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "leaderboard.text.primary": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "leaderboard.text.value": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "primary",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "leaderboard.text.secondary": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "isBold": false,
      "overflow": "CLAMP"
    }
  }
}
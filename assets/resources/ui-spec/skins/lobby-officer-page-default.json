{
  "id": "lobby-officer-page-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "officer.page.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 232
    },
    "officer.page.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 140
    },
    "officer.page.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 28,
      "lineHeight": 34,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "officer.page.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "officer.page.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    }
  }
}

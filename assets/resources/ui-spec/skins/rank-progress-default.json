{
  "id": "rank-progress-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "rank.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 240
    },
    "rank.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 140
    },
    "rank.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 28,
      "lineHeight": 34,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "rank.label.exp": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "rank.label.row": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "rank.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    }
  }
}

{
  "id": "relation-graph-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "mp.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 255
    },
    "mp.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 255
    },
    "mp.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "mp.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "SHRINK"
    },
    "mp.label.meta": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 26,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "mp.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "mp.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "mp.node.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 255
    },
    "mp.center.bg": {
      "kind": "color-rect",
      "color": "secondaryLight",
      "alpha": 255
    },
    "mp.peek.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 255
    },
    "mp.label.node": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 18,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "SHRINK",
      "outlineColor": "backgroundDeep",
      "outlineWidth": 4
    },
    "mp.label.centerName": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER",
      "outlineColor": "backgroundDeep",
      "outlineWidth": 4
    },
    "mp.label.bodyCenter": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER"
    }
  }
}

      "lineHeight": 52,
      "color": "#F6E7C3",
      "isBold": false,
      "overflow": "CLAMP",
      "letterSpacing": 10
    },
    "rival.label.name": {
      "kind": "label-style",
      "font": "fonts/notoserif_tc/notoserif_tc",

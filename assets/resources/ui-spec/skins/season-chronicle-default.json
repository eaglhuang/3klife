{
  "id": "season-chronicle-default",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "season.chronicle.card.bg": {
      "kind": "sprite-frame",
      "path": "sprites/ui_families/common/parchment/frame",
      "spriteType": "sliced",
      "border": [
        16,
        16,
        16,
        16
      ],
      "allowAutoAtlas": true
    },
    "season.chronicle.row.bg": {
      "kind": "sprite-frame",
      "path": "sprites/ui_families/common/parchment/fill",
      "spriteType": "sliced",
      "border": [
        16,
        16,
        16,
        16
      ],
      "allowAutoAtlas": true,
      "opacity": 0.85
    },
    "season.chronicle.button.bg": {
      "kind": "button-skin",
      "normal": "sprites/ui_families/common/paper_utility/btn_primary_normal",
      "pressed": "sprites/ui_families/common/paper_utility/btn_primary_pressed",
      "disabled": "sprites/ui_families/common/paper_utility/btn_primary_disabled",
      "spriteType": "sliced",
      "border": [
        20,
        20,
        20,
        20
      ],
      "allowAutoAtlas": true
    },
    "season.chronicle.close.bg": {
      "kind": "button-skin",
      "normal": "sprites/ui_families/common/paper_utility/btn_primary_normal",
      "pressed": "sprites/ui_families/common/paper_utility/btn_primary_pressed",
      "disabled": "sprites/ui_families/common/paper_utility/btn_primary_disabled",
      "spriteType": "sliced",
      "border": [
        20,
        20,
        20,
        20
      ],
      "allowAutoAtlas": true
    },
    "season.chronicle.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 30,
      "lineHeight": 40,
      "color": "textOnParchment",
      "overflow": "CLAMP",
      "isBold": true
    },
    "season.chronicle.label.heading": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "textOnParchment",
      "overflow": "CLAMP",
      "isBold": true
    },
    "season.chronicle.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 28,
      "color": "textOnParchment",
      "overflow": "CLAMP"
    },
    "season.chronicle.label.note": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 18,
      "lineHeight": 26,
      "color": "textOnParchmentMuted",
      "overflow": "CLAMP"
    },
    "season.chronicle.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "textOnParchment",
      "overflow": "CLAMP",
      "isBold": true
    },
    "season.chronicle.backdrop.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 200
    },
    "season.chronicle.page.bg": {
      "kind": "button-skin",
      "normal": "sprites/ui_families/common/paper_utility/btn_primary_normal",
      "pressed": "sprites/ui_families/common/paper_utility/btn_primary_pressed",
      "disabled": "sprites/ui_families/common/paper_utility/btn_primary_disabled",
      "spriteType": "sliced",
      "border": [
        20,
        20,
        20,
        20
      ],
      "allowAutoAtlas": true
    }
  }
}

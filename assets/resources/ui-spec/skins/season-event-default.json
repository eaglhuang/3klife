      "color": "secondaryLight",
      "overflow": "CLAMP"
    },
    "season.event.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 20,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "season.event.backdrop.bg": {

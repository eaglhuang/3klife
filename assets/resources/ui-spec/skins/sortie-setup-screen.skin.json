{
  "id": "sortie-setup-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "sortie.backdrop.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 200
    },
    "sortie.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "sortie.slot.bg": {
      "kind": "color-rect",
      "color": "backgroundMid",
      "alpha": 230
    },
    "sortie.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "sortie.button.confirm.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 220
    },
    "sortie.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "sortie.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 30,
      "lineHeight": 38,
      "color": "secondaryLight",
      "overflow": "SHRINK",
      "isBold": true
    },
    "sortie.label.stats": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "sortie.label.meta": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 18,
      "lineHeight": 24,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "sortie.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "RESIZE_HEIGHT"
    },
    "sortie.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 22,
      "lineHeight": 28,
      "color": "secondaryLight",
      "overflow": "SHRINK",
      "isBold": true
    }
  }
}

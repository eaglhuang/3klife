{
  "id": "strategist-hud-battle",
  "version": 1,
  "bundle": "battle_ui",
  "atlasPolicy": "battle_ui",
  "slots": {
    "strategist.band.bg": {
      "kind": "color",
      "color": "#160F09",
      "alpha": 220,
      "cornerRadius": 10,
      "borderColor": "#FFD65A",
      "borderWidth": 2,
      "_doc": "PROG-2-9705：對齊格子 buff 徽章，深色底＋金圈"
    },
    "strategist.wisdom.track": {
      "kind": "color",
      "color": "backgroundNavyAlt",
      "alpha": 200
    },
    "strategist.wisdom.fill": {
      "kind": "color",
      "color": "accentGoldCta",
      "alpha": 255
    },
    "strategist.label.summary": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "#FFFFFF",
      "overflow": "RESIZE_HEIGHT",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "strategist.label.wisdom": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 32,
      "color": "textAccent",
      "isBold": true,
      "overflow": "SHRINK",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "strategist.wisdom.hit": {
      "kind": "color",
      "color": "backgroundNavyAlt",
      "alpha": 0,
      "_doc": "全透明；膠囊外觀由 StrategistHudComposite 繪製（PROG-2-10133）"
    },
    "strategist.label.wisdom.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 30,
      "color": "textAccent",
      "isBold": true,
      "overflow": "SHRINK",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "strategist.label.wisdom.value": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 22,
      "lineHeight": 30,
      "color": "textAccent",
      "isBold": true,
      "overflow": "SHRINK",
      "horizontalAlign": "RIGHT",
      "verticalAlign": "CENTER",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    }
  }
}

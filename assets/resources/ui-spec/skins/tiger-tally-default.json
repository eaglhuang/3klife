{
  "id": "tiger-tally-default",
  "version": 2,
  "bundle": "battle_ui",
  "atlasPolicy": "tiger_tally",
  "_doc": "虎符卡片區皮膚。水墨+鋼鐵主題：深色底板、金色稀有度框、兵種標章。",
  "slots": {
    "tally.card.bg": {
      "kind": "color-rect",
      "color": "surfaceTeal",
      "alpha": 236,
      "_doc": "保留給 debug 白模使用的基礎色塊卡面；正式 BattleScene 會改掛 tally.card.bg.hard。"
    },
    "tally.card.bg.hard": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/006/spriteFrame",
      "spriteType": "sliced",
      "border": [
        60,
        60,
        60,
        60
      ],
      "bleed": 2,
      "allowAutoAtlas": true,
      "_fallback": "#1A1208",
      "_doc": "虎符卡面硬版主框核心（006 母框拆件）。第三輪加厚 border，讓 title plaque、left chip、bottom stars 都落在主框內部的視覺包覆範圍。"
    },
    "tally.card.frame.full": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_full_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "SSR 母框完整參考版。主要用於對位與美術檢查，不建議直接作為 runtime 拉伸件。"
    },
    "tally.card.frame.core": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/006/spriteFrame",
      "spriteType": "sliced",
      "border": [
        60,
        60,
        60,
        60
      ],
      "allowAutoAtlas": true,
      "_doc": "006 母框的 stretch-safe 外框核心。第三輪以更厚的 9-slice 包覆 title 與 star band。"
    },
    "tally.card.frame.titlePlaque": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_title_plaque_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "上方標題牌匾 overlay，獨立回貼，避免跟外框一起拉伸。"
    },
    "tally.card.frame.leftChip": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_left_chip_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "左側小 chip / cost 承載件，獨立 overlay。"
    },
    "tally.card.frame.rarityBadgePlaque": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_rarity_badge_plaque_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "稀有度 badge / crest 承載牌。可供 rarity / star 視覺模組掛載。"
    },
    "tally.card.frame.sideRail.dark": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_side_rail_dark_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "右側窄 dark carrier。對齊參考圖後改回較長的內嵌結構，承接徽記與功能 icon 區。"
    },
    "tally.card.frame.sideRail.amber": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_side_rail_amber_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "右側上端短 amber cap / seat overlay。僅保留短上帽，與下方 dark carrier 形成更接近參考圖的連續輪廓。"
    },
    "tally.card.frame.bottomBand": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/frame-parts/ssr/tally_frame_bottom_band_ssr/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "底部中央 band overlay，承接 grain cost / set / status 小圖。"
    },
    "tally.card.art": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/card-art/troops/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": false,
      "_fallback": "#2A3040"
    },
    "tally.card.topShade": {
      "kind": "color-rect",
      "color": "#09111BCC",
      "_doc": "卡片頂部資訊遮罩，讓名稱與角標在大頭像上保持可讀。"
    },
    "tally.card.statBar": {
      "kind": "color-rect",
      "color": "#071018D9",
      "_doc": "卡片底部數值條，參考戰場英雄卡的底部數值區。"
    },
    "tally.card.costPlate": {
      "kind": "color-rect",
      "color": "#0E1824E0",
      "_doc": "右上糧草小角標，降低體積但保留一眼可讀。"
    },
    "tally.card.rarity.normal": {
      "kind": "sprite-frame",
      "path": "sprites/battle/tally_rarity_normal/spriteFrame",
      "spriteType": "sliced",
      "border": [
        4,
        4,
        4,
        4
      ],
      "allowAutoAtlas": true,
      "_fallback": "#6E7A8A"
    },
    "tally.card.rarity.rare": {
      "kind": "sprite-frame",
      "path": "sprites/battle/tally_rarity_rare/spriteFrame",
      "spriteType": "sliced",
      "border": [
        4,
        4,
        4,
        4
      ],
      "allowAutoAtlas": true,
      "_fallback": "#D4AF37"
    },
    "tally.card.rarity.epic": {
      "kind": "sprite-frame",
      "path": "sprites/battle/tally_rarity_epic/spriteFrame",
      "spriteType": "sliced",
      "border": [
        4,
        4,
        4,
        4
      ],
      "allowAutoAtlas": true,
      "_fallback": "#A855F7"
    },
    "tally.card.disabled": {
      "kind": "sprite-frame",
      "path": "sprites/battle/tally_card_disabled/spriteFrame",
      "spriteType": "sliced",
      "border": [
        0,
        0,
        0,
        0
      ],
      "allowAutoAtlas": true,
      "_fallback": "#000000",
      "_fallbackOpacity": 160,
      "_doc": "冷卻遮罩：半透明黑色疊加，含冷卻 icon（由TS動態添加Label顯示回合數）"
    },
    "tally.badge.type": {
      "kind": "sprite-frame",
      "path": "sprites/battle/battle_unit_type_underlay/spriteFrame",
      "spriteType": "simple",
      "allowAutoAtlas": true,
      "_doc": "兵種符頭像：cavalry/infantry/archer/pike/shield/engineer。TS 依 TroopType 切換不同 spriteFrame。"
    },
    "tally.label.rarity": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#FFE28A",
      "horizontalAlign": "RIGHT",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,
      "_doc": "乙版：品階字（R/SR/SSR/UR）貼右上，顏色由主題資料決定。"
    },
    "tally.label.stars": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#F1C453",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER",
      "isBold": false,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 2,
      "_doc": "乙版：星級，空星顯示品質封頂（R3／SR4／SSR5／UR5）。"
    },
    "widget.resource.icon": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "#F6D37A",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "isBold": true,
      "_doc": "資源 icon 用的 glyph 樣式，供糧草符號或同類資源 glyph 使用。"
    },
    "tally.label.atk": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "#FFFFFF",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "isBold": true,
      "_doc": "底部左側主數值，改成偏戰術藍，接近參考圖的側欄資訊節奏。",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "tally.label.hp": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "#FFFFFF",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "isBold": true,
      "_doc": "底部右側主數值，使用高亮薄荷綠提高生存資訊辨識。",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "tally.label.name": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#FFF1D8",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,
      "_doc": "乙版：名稱靠左，右側讓給品階字；超長縮字。"
    },
    "tally.label.sub": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "#A6B8CA",
      "horizontalAlign": "LEFT",
      "overflow": "truncate",
      "_doc": "特殊部隊副標，補足這是戰術單位卡而非武將卡的辨識。",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "tally.label.stats": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "textCoolGray",
      "horizontalAlign": "LEFT",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "tally.label.cost": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#FFEC96",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,
      "_doc": "乙版：糧耗；數字前綴走 i18n（ui.tally.card.grain）。"
    },
    "tally.label.badge": {
      "kind": "label-style",
      "font": "fonts/manrope/manrope",
      "fontSize": 24,
      "lineHeight": 28,
      "color": "colorWhite",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "isBold": true,
      "_doc": "兵種徽章縮寫文字（CV/IN/AR/SH...），白色置中，由 Layout JSON 定義，TigerTallyPanel 只負責填入文字。lineHeight 必須 >= fontSize 避免 Cocos 裁切。",
      "outlineColor": "#1E1208",
      "outlineWidth": 3
    },
    "tally.card.frame.v2": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/theme/tally_frame_placeholder/spriteFrame",
      "spriteType": "sliced",
      "border": [
        40,
        40,
        40,
        56
      ],
      "allowAutoAtlas": true,
      "_doc": "虎符卡乙版框圖佔位（287x142 白底，執行期乘品階色）；實際路徑與色板由 ui-spec/tiger-tally-card-theme.json 決定，交件正式框圖後只改那份資料。"
    },
    "tally.card.brushed": {
      "kind": "sprite-frame",
      "path": "ui/tiger-tally/theme/brushed-128/spriteFrame",
      "spriteType": "tiled",
      "allowAutoAtlas": false,
      "_doc": "共用 128x128 灰階可平鋪拉絲圖，四階卡共用同一張貼圖，只調不透明度。"
    },
    "tally.label.owner": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#C9B88F",
      "horizontalAlign": "LEFT",
      "verticalAlign": "CENTER",
      "isBold": false,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 2,
      "_doc": "乙版：持有武將行（未獲得時顯示「未獲得」）。"
    },
    "tally.label.resonance": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#FFFFFF",
      "horizontalAlign": "RIGHT",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,
      "_doc": "乙版：星級共鳴倍率（ui.tally.card.resonance）。"
    },
    "tally.label.flag": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#7CFF9B",
      "horizontalAlign": "RIGHT",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,

    },
    "tally.label.infuse": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 21,
      "lineHeight": 24,
      "color": "#DFE5EC",
      "horizontalAlign": "CENTER",
      "verticalAlign": "CENTER",
      "isBold": true,
      "overflow": "SHRINK",
      "outlineColor": "#1E1208",
      "outlineWidth": 3,
      "_doc": "乙版：灌注小章（Lv5 銀、Lv8 金），顏色由主題資料決定。"
    }

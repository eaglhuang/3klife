{
  "id": "warehouse-panel-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "wp.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "wp.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "wp.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 32,
      "lineHeight": 40,
      "color": "secondaryLight",
      "isBold": true,
      "overflow": "CLAMP"
    },
    "wp.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/font",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    }
  }
}

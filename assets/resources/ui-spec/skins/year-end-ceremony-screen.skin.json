{
  "id": "year-end-ceremony-screen.skin",
  "version": 1,
  "bundle": "lobby_ui",
  "atlasPolicy": "lobby_ui",
  "slots": {
    "yc.card.bg": {
      "kind": "color-rect",
      "color": "backgroundDeep",
      "alpha": 246
    },
    "yc.button.bg": {
      "kind": "color-rect",
      "color": "primary",
      "alpha": 160
    },
    "yc.label.title": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 34,
      "lineHeight": 44,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    },
    "yc.label.body": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "yc.label.button": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 24,
      "lineHeight": 30,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "yc.label.standing": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 26,
      "lineHeight": 34,
      "color": "secondaryLight",
      "overflow": "SHRINK"
    },
    "yc.label.reward": {
      "kind": "label-style",
      "font": "fonts/notosans_tc/notosans_tc",
      "fontSize": 28,
      "lineHeight": 36,
      "color": "secondaryLight",
      "overflow": "CLAMP",
      "isBold": true
    }
  }
}
{
  "id": "ui-theme-registry",
  "version": 1,
  "$note": "UI 主題登錄表：default 提供全部語意 token，其餘主題只寫差異並疊加在 default 之上。新增節慶主題步驟見規格「UI 共用框架：主題系統與語系」。",
  "defaultTheme": "default",
  "layerOrder": [
    "season",
    "festival",
    "event"
  ],
  "styleBinding": {
    "appliesToSkins": [
      "lobby-hall-screen.skin",
      "hall-board-screen.skin",
      "governor-hall-screen.skin",
      "recruit-hall-screen.skin"
    ],
    "slotRoles": {
      ".panel.solid": "glassPanelSolid",
      ".card.bg": "glassPanel",
      ".row.bg": "insetPanel",
      ".spot.bg": "insetPanel",
      ".button.bg": "buttonSecondary",
      ".label.section": "labelSection",
      ".divider.section": "divider"
    },
    "skipSlots": [
      "pg.*"
    ],
    "fillRoles": {
      "secondary": "buttonSecondary",
      "primary": "buttonAccent",
      "stdButtonPrimary": "buttonAccent",
      "#A8322A": "buttonAccent"
    }
  },
  "themes": {
    "default": {
      "nameKey": "ui.theme.name.default",
      "tokens": {
        "text.font": "fonts/notoserif_tc/notoserif_tc",
        "text.title.minSize": 26,
        "nameTag.ringColor": "#E8C88CA0",
        "nameTag.sealColor": "#A8322A",
        "nameTag.sealTextColor": "#FFF0D7",
        "panel.bg": "#140F0C",
        "panel.alpha": 118,
        "panel.cornerRadius": 4,
        "panel.borderWidth": 1,
        "panel.border": "#E8C88CA0",
        "panel.solid.alpha": 255,
        "panel.inset.bg": "#FFF0D7",
        "panel.inset.alpha": 14,
        "panel.inset.cornerRadius": 4,
        "panel.inset.borderWidth": 1,
        "panel.inset.border": "#E8C88C50",
        "button.secondary.bg": "#FFF0D7",
        "button.secondary.alpha": 20,
        "button.secondary.cornerRadius": 2,
        "button.secondary.borderWidth": 1,
        "button.secondary.border": "#E8C88C70",
        "button.primary.bg": "#A8322A",
        "button.primary.alpha": 190,
        "button.primary.cornerRadius": 2,
        "button.primary.borderWidth": 1,
        "button.primary.border": "#F0B48C99",
        "divider.color": "#E8C88C",
        "divider.alpha": 110,
        "text.title": "#F6E7C3",
        "text.section": "#C4A05C",
        "text.section.letterSpacing": 8,
        "text.body": "#D9C9A6",
        "text.button": "#F1E5CC",
        "settle.panel.bg": "#F6E7C1",
        "settle.panel.alpha": 255,
        "settle.panel.cornerRadius": 28,
        "settle.panel.borderWidth": 4,
        "settle.panel.border": "#C9A060",
        "settle.header.bg": "#EBD39A",
        "settle.header.alpha": 255,
        "settle.inset.bg": "#F6E7C1",
        "settle.inset.alpha": 200,
        "settle.inset.cornerRadius": 14,
        "settle.inset.borderWidth": 2,
        "settle.inset.border": "#C9A060",
        "settle.section.bg": "#FFF3D2",
        "settle.section.alpha": 210,
        "settle.section.cornerRadius": 10,
        "settle.section.borderWidth": 1,
        "settle.section.border": "#D8B878",
        "settle.row.bg": "#8C5A1E",
        "settle.row.alpha": 30,
        "settle.row.cornerRadius": 8,
        "settle.avatar.bg": "#2E2422",
        "settle.avatar.border": "#E8BE60",
        "settle.text.title": "#B03018",
        "settle.text.heading": "#7A3E10",
        "settle.text.key": "#8A4B12",
        "settle.text.value": "#3B2410",
        "settle.text.muted": "#8A6A3A",
        "settle.rule.color": "#B07A2A",
        "settle.rule.alpha": 200,
        "settle.button.dark.bg": "#2B2724",
        "settle.button.dark.alpha": 255,
        "settle.button.dark.cornerRadius": 16,
        "settle.button.dark.borderWidth": 2,
        "settle.button.dark.border": "#14110F",
        "settle.button.gold.bg": "#8A5A1E",
        "settle.button.gold.alpha": 255,
        "settle.button.gold.cornerRadius": 16,
        "settle.button.gold.borderWidth": 2,
        "settle.button.gold.border": "#E8BE60",
        "settle.text.button": "#FFF3D6"
      }
    },
    "spring": {
      "nameKey": "ui.theme.name.spring",
      "tokens": {
        "panel.border": "#B8D8A0A0",
        "text.section": "#A8C888",
        "settle.panel.border": "#9CB872",
        "settle.inset.border": "#9CB872"
      }
    },
    "summer": {
      "nameKey": "ui.theme.name.summer",
      "tokens": {
        "panel.border": "#8CD0E8A0",
        "text.section": "#7CBCD8",
        "settle.panel.border": "#6FB4CC",
        "settle.inset.border": "#6FB4CC"
      }
    },
    "autumn": {
      "nameKey": "ui.theme.name.autumn",
      "tokens": {
        "panel.border": "#E8A860A0",
        "text.section": "#D09048",
        "settle.panel.border": "#D08A3C",
        "settle.inset.border": "#D08A3C"
      }
    },
    "winter": {
      "nameKey": "ui.theme.name.winter",
      "tokens": {
        "panel.border": "#C8DCF0A0",
        "text.section": "#A8C0DC",
        "text.title": "#F4F8FF",
        "settle.panel.bg": "#EEF2F6",
        "settle.panel.border": "#A8C0DC",
        "settle.inset.border": "#A8C0DC",
        "settle.header.bg": "#D5E0EC"
      }
    },
    "lunar-new-year": {
      "nameKey": "ui.theme.name.lunar-new-year",
      "$note": "節慶範例：只覆寫差異；素材層格式 assets:{\"hall.festival.decor\":{\"path\":\"...\",\"bundle\":\"可選\"}}，待美術交付後補上。季節背景圖仍由 data/hall-map/hall-theme.json 管。",
      "tokens": {
        "button.primary.bg": "#C8281E",
        "button.primary.alpha": 220,
        "button.primary.border": "#FFD878CC",
        "panel.border": "#FFD878B0",
        "text.title": "#FFE9A8",
        "text.section": "#FFC850",
        "settle.panel.bg": "#FBE9C8",
        "settle.panel.border": "#E0A020",
        "settle.button.gold.bg": "#C8281E",
        "settle.button.gold.border": "#FFD878"
      }
    }
  },
  "rules": [
    {
      "id": "season-spring",
      "layer": "season",
      "theme": "spring",
      "when": {
        "seasonIndex": 1
      }
    },
    {
      "id": "season-summer",
      "layer": "season",
      "theme": "summer",
      "when": {
        "seasonIndex": 2
      }
    },
    {
      "id": "season-autumn",
      "layer": "season",
      "theme": "autumn",
      "when": {
        "seasonIndex": 3
      }
    },
    {
      "id": "season-winter",
      "layer": "season",
      "theme": "winter",
      "when": {
        "seasonIndex": 4
      }
    },
    {
      "id": "festival-lunar-new-year-flag",
      "layer": "festival",
      "theme": "lunar-new-year",
      "priority": 10,
      "when": {
        "festivalIds": [
          "lunar-new-year"
        ]
      }
    },
    {
      "id": "festival-lunar-new-year-date",
      "layer": "festival",
      "theme": "lunar-new-year",
      "priority": 1,
      "when": {
        "dateRange": {
          "from": "01-20",
          "to": "02-20"
        }
      }
    }
  ],
  "familyBindings": {
    "settle": {
      "$note": "戰場『勝利』結算視窗風格（米黃金框面板、紅標題、內嵌清單、深灰／深金按鈕）抽成的共用家族；大廳任務類視窗改在這裡登記 skin 與 slot 對應，不各自複製樣式。換季／節慶只覆寫 settle.* token。slot 對應可寫完整 slot id 或後綴（最長優先）。",
      "appliesToSkins": [
        "lobby-mission-detail-dialog-default",
        "extreme-task-screen.skin",
        "result-popup-default"
      ],
      "slotRoles": {
        "mission.dialog.card.bg": "panel",
        "mission.dialog.header.bg": "header",
        "mission.dialog.footer.bg": "header",
        "mission.dialog.scroll.bg": "inset",
        "mission.dialog.section.bg": "section",
        "mission.dialog.row.bg": "rowAlt",
        "mission.dialog.btn.primary": "buttonGold",
        "mission.dialog.btn.secondary": "buttonDark",
        "mission.dialog.label.header": "labelTitle",
        "mission.dialog.label.section": "labelKey",
        "mission.dialog.label.title": "labelHeading",
        "mission.dialog.label.body": "labelValue",
        "mission.dialog.label.muted": "labelMuted",
        "mission.dialog.label.metric": "labelValue",
        "mission.dialog.label.cost": "labelKey",
        "mission.dialog.label.reward": "labelHeading",
        "mission.dialog.label.dropdown": "labelValue",
        "mission.dialog.label.button": "labelButton",
        "et.card.bg": "panel",
        "et.button.bg": "buttonGold",
        "et.label.title": "labelTitle",
        "et.label.body": "labelValue",
        "popup.detail.bg": "inset",
        "popup.avatar.ring": "avatarRing",
        "mission.dialog.dropdown.btn": "buttonDark",
        "mission.dialog.close.btn": "buttonDark"
      },
      "roles": {
        "panel": {
          "kind": "color-rect",
          "color": "@settle.panel.bg",
          "alpha": "@settle.panel.alpha",
          "cornerRadius": "@settle.panel.cornerRadius",
          "borderWidth": "@settle.panel.borderWidth",
          "borderColor": "@settle.panel.border"
        },
        "header": {
          "kind": "color-rect",
          "color": "@settle.header.bg",
          "alpha": "@settle.header.alpha"
        },
        "inset": {
          "kind": "color-rect",
          "color": "@settle.inset.bg",
          "alpha": "@settle.inset.alpha",
          "cornerRadius": "@settle.inset.cornerRadius",
          "borderWidth": "@settle.inset.borderWidth",
          "borderColor": "@settle.inset.border"
        },
        "section": {
          "kind": "color-rect",
          "color": "@settle.section.bg",
          "alpha": "@settle.section.alpha",
          "cornerRadius": "@settle.section.cornerRadius",
          "borderWidth": "@settle.section.borderWidth",
          "borderColor": "@settle.section.border"
        },
        "rowAlt": {
          "kind": "color-rect",
          "color": "@settle.row.bg",
          "alpha": "@settle.row.alpha",
          "cornerRadius": "@settle.row.cornerRadius"
        },
        "avatarRing": {
          "kind": "color-rect",
          "color": "@settle.avatar.bg",
          "borderColor": "@settle.avatar.border"
        },
        "buttonDark": {
          "kind": "color-rect",
          "color": "@settle.button.dark.bg",
          "alpha": "@settle.button.dark.alpha",
          "cornerRadius": "@settle.button.dark.cornerRadius",
          "borderWidth": "@settle.button.dark.borderWidth",
          "borderColor": "@settle.button.dark.border"
        },
        "buttonGold": {
          "kind": "color-rect",
          "color": "@settle.button.gold.bg",
          "alpha": "@settle.button.gold.alpha",
          "cornerRadius": "@settle.button.gold.cornerRadius",
          "borderWidth": "@settle.button.gold.borderWidth",
          "borderColor": "@settle.button.gold.border"
        },
        "labelTitle": {
          "color": "@settle.text.title"
        },
        "labelHeading": {
          "color": "@settle.text.heading"
        },
        "labelKey": {
          "color": "@settle.text.key"
        },
        "labelValue": {
          "color": "@settle.text.value"
        },
        "labelMuted": {
          "color": "@settle.text.muted"
        },
        "labelButton": {
          "color": "@settle.text.button"
        }
      }
    }
  }
}

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8">
    <title><%= projectName %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="stylesheet" type="text/css" href="<%= cssUrl %>">
    <link rel="preload" as="image" href="boot-bg.jpg">
    <link rel="icon" href="favicon.ico">
    <link rel="apple-touch-icon" href="favicon.ico">
  </head>
  <body>
    <!-- 引擎與標題載入前先鋪標題底圖（PROG-2-2240），標題掛好後由 LoginScene 移除；大小同 GameDiv，鋪滿視窗。 -->
    <div id="web-boot-backdrop" aria-hidden="true"></div>
    <!-- 先於引擎下載顯示；沒有可知總量，不捏造百分比。 -->
    <div id="web-boot-progress" role="status" aria-live="polite"
      style="position:fixed;left:10%;right:10%;bottom:12%;text-align:center;color:#e8d9a8;font:16px/1.6 sans-serif;z-index:2147483646;pointer-events:none">
      正在啟動遊戲…初次載入可能需要較久，請稍候。
    </div>
    <script>
      (function () {
        function bootFailed() {
          var status = document.getElementById('web-boot-progress');
          if (status) status.textContent = '啟動遇到問題，若持續停留請重新整理。';
        }
        window.addEventListener('error', bootFailed);
        window.addEventListener('unhandledrejection', bootFailed);
        window.addEventListener('3klife-boot-ready', function () {
          window.removeEventListener('error', bootFailed);
          window.removeEventListener('unhandledrejection', bootFailed);
        }, { once: true });
      })();
    </script>
    <div id="GameDiv" cc_exact_fit_screen="false">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" tabindex="0" aria-label="3KLife 遊戲畫面"></canvas>
      </div>
    </div>
    <%- include(cocosTemplate, {}) %>
    <script src="responsive-frame.js"></script>
  </body>
</html>

{
  "schemaId": "taskflow.profile.v1",
  "id": "cid-hardening-taskflow-profile-v1",
  "name": "CID Hardening Governed Opener",
  "repoLabel": "CID Hardening Planning Lane",
  "ownerRepo": "3KLife",
  "taskIdPrefix": "TASK-CID",
  "taskId": {
    "format": "TASK-CID-NNNN"
  },
  "template": {
    "defaultMarkdown": "# ${taskId} ${title}\n\n## Goal\n${description}"
  },
  "capabilities": {
    "supportsDryRun": true,
    "supportsWrite": false
  },
  "delegationDisplayHint": "CID lane opener may execute governed writes through taskflow open.",
  "delegation": {
    "hint": "Host opener supplies CID lane numbering and task-card output policy through a governed opener contract.",
    "openerPath": "tools_node/task-card-opener.js",
    "policy": {
      "allocateTaskId": {
        "mode": "host-opener",
        "prefix": "TASK-CID",
        "format": "TASK-CID-NNNN"
      },
      "resolveCanonicalOutputPath": {
        "mode": "fallback",
        "pattern": "docs/ai_atomic_framework/cid-hardening/tasks/${taskId}.task.md",
        "directory": "docs/ai_atomic_framework/cid-hardening/tasks"
      },
      "rosterSyncPolicy": "none",
      "rosterSync": {
        "indexPath": "docs/ai_atomic_framework/cid-hardening/tasks/README.md"
      },
      "fallbackBehavior": {
        "mode": "template-only-fallback",
        "reason": "CID lane requires explicit output-path selection until slug policy is encoded in the host opener contract.",
        "missingPrerequisites": [
          "explicit output path required"
        ]
      }
    },
    "writerInvocation": {
      "describeOnly": false,
      "displayHint": "node tools_node/task-card-opener.js --write --task ${taskId}"
    }
  }
}

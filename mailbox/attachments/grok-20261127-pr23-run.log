import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import tempfile
import time
from unittest import TestCase, mock
from urllib.request import urlopen

from tools import preview_server as preview


class PreviewServerTest(TestCase):
    def setUp(self):
        sandbox = self.enterContext(tempfile.TemporaryDirectory())
        self.root = Path(sandbox)
        (self.root / 'render').mkdir()
        self.index = b'<!doctype html><title>preview fixture</title>'
        (self.root / 'render' / 'index.html').write_bytes(self.index)
        requested = os.environ.get('PREVIEW_TEST_PORT')
        with socket.socket() as sock:
            if os.name == 'posix':
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(('127.0.0.1', int(requested) if requested else 0))
            self.port = sock.getsockname()[1]
        self.url = f'http://127.0.0.1:{self.port}/render/index.html'
        self.enterContext(mock.patch.dict(os.environ, {
            'RENDER_HOST': '127.0.0.1', 'RENDER_PORT': str(self.port),
        }))

    def assert_serving(self):
        with urlopen(self.url, timeout=1) as response:
            self.assertEqual(response.read(), self.index)

    def assert_reaped(self, process):
        # Check wait() has already collected the process, before polling it.
        self.assertIsNotNone(process.returncode)
        with self.assertRaises(OSError):
            socket.create_connection(('127.0.0.1', self.port), timeout=0.25)
        with preview.preview_server(root=self.root) as replacement:
            self.assertIsNotNone(replacement)
            self.assert_serving()

    def test_success_waits_and_releases_port(self):
        with preview.preview_server(root=self.root) as process:
            self.assertIsNotNone(process)
            self.assertIsNone(process.poll())
            self.assert_serving()
        self.assert_reaped(process)

    def test_exception_waits_and_releases_port(self):
        with self.assertRaisesRegex(ValueError, 'render failed'):
            with preview.preview_server(root=self.root) as process:
                self.assert_serving()
                raise ValueError('render failed')
        self.assert_reaped(process)

    def test_startup_timeout_reaps_failed_child(self):
        # Real subprocess that stays alive but never starts serving.
        with subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(60)']) as process:
            try:
                with mock.patch.object(preview, '_start', return_value=process):
                    with self.assertRaisesRegex(TimeoutError, 'not ready'):
                        with preview.preview_server(root=self.root, timeout=0.2):
                            self.fail('not-ready service must not reach the renderer')
                self.assert_reaped(process)
            finally:
                if process.poll() is None:
                    process.kill()

    def start_external(self, root):
        process = self.enterContext(subprocess.Popen([
            sys.executable, '-m', 'http.server', str(self.port), '--bind', '127.0.0.1',
            '--directory', str(root),
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        # Register cleanup on the test fixture's own Popen, not on a port.
        self.addCleanup(preview._stop, process)
        until = time.monotonic() + 4
        while time.monotonic() < until:
            try:
                with urlopen(self.url, timeout=0.2):
                    return process
            except OSError:
                if process.poll() is not None:
                    self.fail(f'test server exited {process.returncode}')
                time.sleep(0.025)
        self.fail('test server did not start')

    def test_external_service_survives_reuse_and_render_failure(self):
        external = self.start_external(self.root)
        pid = external.pid
        with mock.patch.object(preview, '_start', side_effect=AssertionError('no own launch')):
            with preview.preview_server(root=self.root) as process:
                self.assertIsNone(process)
                self.assert_serving()
            with self.assertRaises(ValueError):
                with preview.preview_server(root=self.root):
                    raise ValueError('render failed')
        self.assertEqual(external.pid, pid)
        self.assertIsNone(external.poll())
        self.assert_serving()

    def test_foreign_http_service_is_not_reused_or_stopped(self):
        other = self.root / 'other'
        (other / 'render').mkdir(parents=True)
        (other / 'render' / 'index.html').write_text('unrelated')
        external = self.start_external(other)
        with self.assertRaisesRegex(RuntimeError, 'Preview server exited'):
            with preview.preview_server(root=self.root):
                self.fail('wrong server should not reach the renderer')
        self.assertIsNone(external.poll())
        with urlopen(self.url, timeout=1) as response:
            self.assertEqual(response.read(), b'unrelated')

    def test_sigint_and_sigterm_cleanup(self):
        if os.name != 'posix':
            self.skipTest('test delivers real POSIX signals to a child process')
        code = '''
import sys, time
from tools.preview_server import preview_server, PreviewInterrupted
try:
    with preview_server(root=sys.argv[1]) as service:
        print(service.pid, flush=True)
        time.sleep(60)
except PreviewInterrupted as exc:
    raise SystemExit(128 + exc.signum)
'''
        for signum in (signal.SIGINT, signal.SIGTERM):
            with self.subTest(signum=signum):
                with subprocess.Popen([sys.executable, '-c', code, str(self.root)],
                                      text=True, stdout=subprocess.PIPE) as command:
                    try:
                        import select
                        self.assertTrue(select.select([command.stdout], [], [], 5)[0],
                                        'preview child did not become ready')
                        service_pid = int(command.stdout.readline())
                        self.assert_serving()
                        command.send_signal(signum)
                        self.assertEqual(command.wait(timeout=5), 128 + signum)
                        with self.assertRaises(ProcessLookupError):
                            os.kill(service_pid, 0)
                        with preview.preview_server(root=self.root):
                            self.assert_serving()
                    finally:
                        if command.poll() is None:
                            command.terminate()
                            command.wait(timeout=5)

    def test_cli_preserves_command_status(self):
        for status in (0, 7):
            with self.subTest(status=status):
                program = ('from urllib.request import urlopen; '
                           f'assert urlopen({self.url!r}, timeout=2).status == 200; '
                           f'raise SystemExit({status})')
                process = subprocess.run([
                    sys.executable, '-m', 'tools.preview_server', '--cwd', str(self.root),
                    '--', sys.executable, '-c', program,
                ], capture_output=True, text=True, timeout=10)
                self.assertEqual(process.returncode, status, process.stderr)
                with self.assertRaises(OSError):
                    socket.create_connection(('127.0.0.1', self.port), timeout=0.25)

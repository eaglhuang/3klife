# spine-preview-render

## Setup (once per box)
- `cd render && npm ci` (playwright-core + spine-webgl 4.2); Chrome at `/usr/bin/google-chrome`.
- 從倉庫根目錄用 `venv/bin/python -m tools.preview_server --cwd render -- <command>` 啟動表中的渲染命令。工具預設只在本機 8765 啟動自己的伺服器，正常、失敗或可捕捉中斷時都會等待它退出。相同專案的現有服務可重用，不會由本次命令停止。
- `RENDER_PORT=8895` 可讓服務和渲染共用另一個埠。使用暫存輸出驗證，例如：

  ```bash
  output=$(mktemp -d)
  RENDER_PORT=8895 venv/bin/python -m tools.preview_server --cwd render -- \
    node render.mjs poses "setup|0|$output/pose.png"
  ```

## Commands (pass after `--cwd render --`)
| Need | Command |
|---|---|
| Still frames | `node render.mjs poses cam '{"x":180,"y":560,"zoom":1.3}' "spear_thrust\|0.56\|../frames/v2/a.png" ...` (`setup\|0\|f.png` = setup pose) |
| Skin | insert `skin <name>` before `cam` |
| Only some slots (integrity check) | insert `only pony,torso,skirt` before `cam` (other slots hidden, no ground); `cam '{"bg":[1,0,1]}'` = magenta bg |
| Debug colours + bones | insert `tint '{"l_arm":[1,0.3,0.3]}'` before `cam` |
| Bone world dump | `node render.mjs bones "spear_thrust\|0.30"` |
| Per-frame sample (validator) | `node render.mjs sample spear_thrust 60 ../frames/validate/x.json` |
| Sequence | `rm -rf ../frames/main; node render.mjs seq cam '{"x":260,"y":590,"zoom":1.95}' seq.json` |

`zoom` = world units per screen pixel (bigger = smaller character).

MP4 (repo root): `ffmpeg -y -framerate 30 -i frames/main/%05d.png -c:v libx264 -pix_fmt yuv420p -crf 18 out/preview/zhao_preview.mp4`
(check the frame pattern printed by `seq`). Contact sheet: `venv/bin/python scripts/contact.py` (renders its own frames).

## Hard rules / must-nots
- Always render with the real runtime; never judge a pose from the JSON numbers alone.
- Look at frames at the key times of each beat (presets list `beats:`), zoomed on the joints that were changed
  (knee in the lunge, front arm in the charge, hands on the weapon).
- The Read tool caches images by path: write each new look to a NEW filename.
- `frames/` is git-ignored; only `out/preview/*` deliverables are committed.

## Verification checklist
- [ ] Status line printed `{"s":"ok"...}` listing the expected animations.
- [ ] Viewed the frames (not only generated them) and noted any visual defect with its time.
- [ ] MP4 plays at 30 fps, yuv420p; contact sheet includes the close-ups the change was about.
- [ ] Mirrored generals rendered with `skin hand_mirror flip` (battle spec: `"skin": "hand_mirror", "mirror": true`);
  battle sheets include a hands close-up row and a legs/knees close-up row (`render.mjs sample` also dumps IK mixes `k`).
- [ ] http server stopped.
import { chromium } from 'playwright-core';
import { previewOrigin } from './preview-origin.mjs';
import fs from 'fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const [,,mode,...args]=process.argv;
// character selection: CHAR=<id> (reads ../characters/<id>/char.json) -> serves <root>/out/<name>.json + atlas/<name>.atlas
const CHAR=process.env.CHAR||'zhao';
const assetDir=process.env.RENDER_ASSET_DIR;
const renderDir=path.dirname(fileURLToPath(import.meta.url));
const cfg=assetDir ? {} : JSON.parse(fs.readFileSync(path.join(renderDir,'..','characters',CHAR,'char.json')));
const root=(cfg.root??`characters/${CHAR}`).replace(/^\.\/?/,'').replace(/\/$/,'');
const BASE=assetDir ? '/assets/' : (root?`/${root}`:'')+'/out/';
const NAME=assetDir ? process.env.RENDER_ASSET_NAME : cfg.name||CHAR;
const origin=assetDir ? 'http://spine-preview.local' : previewOrigin;
const browser=await chromium.launch({...(process.env.CHROME ? {executablePath:process.env.CHROME} : {channel:'chrome'}),args:['--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader','--no-sandbox']});
const page=await browser.newPage({viewport:{width:1280,height:720}});
page.on('console',m=>{if(m.type()==='error'||m.type()==='warning')console.log('[page]',m.text())});
page.on('pageerror',e=>console.log('[pageerror]',e.message));
const query=new URLSearchParams({base:BASE,name:NAME});
if(assetDir){
  const atlas=process.env.RENDER_ASSET_ATLAS;
  if(atlas) query.set('atlas',atlas.split(path.sep).join('/'));
  else if(!fs.existsSync(path.join(assetDir,'atlas',NAME+'.atlas'))) query.set('atlas',NAME+'.atlas');
  // Serve assets from this invocation's worktree and output directory.
  await page.route(origin+'/**',async route=>{
    const pathname=decodeURIComponent(new URL(route.request().url()).pathname);
    const prefix=pathname.startsWith(BASE) ? BASE : '/render/';
    const directory=prefix===BASE ? assetDir : renderDir;
    const file=path.resolve(directory,pathname.slice(prefix.length));
    if(pathname.startsWith(prefix) && file.startsWith(path.resolve(directory)+path.sep) &&
        fs.statSync(file,{throwIfNoEntry:false})?.isFile()){
      await route.fulfill({path:file});
    }else{
      await route.fulfill({status:404});
    }
  });
}
await page.goto(`${origin}/render/index.html?${query}`);
await page.waitForFunction(()=>window.status_!=='loading',null,{timeout:30000});
const st=await page.evaluate(()=>({s:window.status_,e:window.errors,a:window.anims}));
console.log(JSON.stringify(st));
if(st.s!=='ok'){await browser.close();process.exit(2);}
if(args[0]==='skin'){await page.evaluate(n=>window.skinName=n,args[1]); args.splice(0,2);}
if(args[0]==='tint'){await page.evaluate(c=>window.tint=c,JSON.parse(args[1])); args.splice(0,2);}
if(args[0]==='flip'){await page.evaluate(()=>window.flipX=true); args.splice(0,1);}   // runtime mirror: skeleton scaleX -1
if(args[0]==='only'){await page.evaluate(l=>window.only=l.split(','),args[1]); args.splice(0,2);}   // QA: draw only these slots (no ground line)
if(args[0]==='cam') {await page.evaluate(c=>Object.assign(window.cam,c),JSON.parse(args[1])); args.splice(0,2);}
const save=async(name,t,file)=>{const d=await page.evaluate(([n,t])=>window.renderPose(n,t),[name,t]); fs.writeFileSync(file,Buffer.from(d.split(',')[1],'base64'));};
if(mode==='sample'){ // anim fps outfile : dump every bone's world state per frame (used by tools/action_gen validate)
  const [n,fps,f]=args; const out=await page.evaluate(([n,fps])=>{const a=skeleton.data.findAnimation(n); const N=Math.round(a.duration*fps); const fr=[];
    for(let i=0;i<=N;i++){const t=i/fps; window.renderPose(n,t); const b={};
      for(const x of skeleton.bones){b[x.data.name]=[x.worldX,x.worldY,x.a,x.b,x.c,x.d,x.ascaleX,x.arotation];}
      const k={}; for(const c of skeleton.ikConstraints) k[c.data.name]=c.mix; fr.push({t,b,k});}
    return {duration:a.duration,frames:fr};},[n,parseFloat(fps)]);
  fs.writeFileSync(f,JSON.stringify(out)); console.log('sampled',n,out.frames.length);
} else if(mode==='samplemany'){ // anim|fps|outfile ... : same dump as 'sample', one browser for many animations (tools/skin_combo_check.py)
  for(const s of args){const [n,fps,f]=s.split('|'); const out=await page.evaluate(([n,fps])=>{const a=skeleton.data.findAnimation(n); const N=Math.round(a.duration*fps); const fr=[];
    for(let i=0;i<=N;i++){const t=i/fps; window.renderPose(n,t); const b={};
      for(const x of skeleton.bones){b[x.data.name]=[x.worldX,x.worldY,x.a,x.b,x.c,x.d,x.ascaleX,x.arotation,x.active?1:0];}
      const k={}; for(const c of skeleton.ikConstraints) if(c.active) k[c.data.name]=c.mix; fr.push({t,b,k});}
    return {duration:a.duration,frames:fr};},[n,parseFloat(fps)]);
  fs.writeFileSync(f,JSON.stringify(out));} console.log('sampled',args.length);
} else if(mode==='bones'){ for(const s of args){const [n,t]=s.split('|'); await page.evaluate(([n,t])=>window.renderPose(n,t),[n,parseFloat(t)]);
   const r=await page.evaluate(()=>['l_upper','l_fore','l_grip','spear','r_upper','r_grip','chest'].map(b=>{const x=skeleton.findBone(b);return b+':'+x.worldX.toFixed(0)+','+x.worldY.toFixed(0)+' r'+x.getWorldRotationX().toFixed(0)}).join('  '));
   console.log(n,t,r);} }
else if(mode==='poses'){ // name:t:file ...
  for(const s of args){const [n,t,f]=s.split('|'); await save(n==='setup'?null:n,parseFloat(t),f);}
} else if(mode==='inspect'){
  const {captures,metadata}=JSON.parse(fs.readFileSync(args[0]));
  const rows=[];
  for(const capture of captures){
    const info=await page.evaluate(({clip,time,skin,flip,masks})=>{
      const animation=skeleton.data.findAnimation(clip);
      if(!animation || animation.duration<=0) throw Error('Missing or empty clip '+clip);
      window.skinName=skin;
      window.flipX=flip;
      window.only=skeleton.slots.map(slot=>slot.data.name);
      const full=window.renderPose(clip,time);
      const bones=Object.fromEntries(skeleton.bones.filter(b=>b.active).map(b=>[
        b.data.name,[b.worldX,b.worldY,b.a,b.b,b.c,b.d]
      ]));
      const shots={full};
      for(const [name,slots] of Object.entries(masks)){
        if(!slots.length) continue;
        window.only=slots;
        shots[name]=window.renderPose(clip,time);
      }
      return {duration:animation.duration,bones,shots};
    },capture);
    for(const [key,shot] of Object.entries(info.shots)){
      fs.writeFileSync(capture.files[key],Buffer.from(shot.split(',')[1],'base64'));
    }
    rows.push({duration:info.duration,bones:info.bones});
  }
  fs.writeFileSync(metadata,JSON.stringify(rows));
} else if(mode==='cycle_frames'){
  const {action,frames,dir,masks,bones=[],idleReference=false,poseReference,includeEndpoint=false}=JSON.parse(fs.readFileSync(args[0]));
  fs.mkdirSync(dir,{recursive:true});
  const duration=await page.evaluate(n=>skeleton.data.findAnimation(n)?.duration??null,action);
  if(!duration) throw Error('Missing or empty cycle '+action);
  if(idleReference){
    await page.evaluate(()=>window.only=skeleton.slots.map(slot=>slot.data.name));
    await save(typeof idleReference==='string' ? idleReference : 'idle',0,`${dir}/idle_reference.png`);
  }
  const referencePose=poseReference && await page.evaluate(([poseReference,bones])=>{
    window.only=skeleton.slots.map(slot=>slot.data.name);
    window.renderPose(...poseReference);
    return Object.fromEntries(bones.flatMap(name=>{
      const b=skeleton.findBone(name);
      return b ? [[name,[b.worldX,b.worldY,b.a,b.b,b.c,b.d]]] : [];
    }));
  },[poseReference,bones]);
  const world=[];
  let setup={};
  for(let i=-1;i<=frames;i++){
    const time=duration*i/frames;
    const capture=await page.evaluate(([action,time,masks,bones,endpoint])=>{
      window.only=skeleton.slots.map(slot=>slot.data.name);
      const full=window.renderPose(action,time);
      const transforms={};
      for(const name of bones){
        const b=skeleton.findBone(name);
        if(b) transforms[name]=[b.worldX,b.worldY,b.a,b.b,b.c,b.d];
      }
      const result=action ? {full} : {};
      if(action && !endpoint){
        for(const [key,slots] of Object.entries(masks)){
          window.only=slots;
          result[key]=window.renderPose(action,time);
        }
      }
      return {result,transforms};
    },[i<0 ? null : action,time,masks,bones,i===frames && !idleReference && !includeEndpoint]);

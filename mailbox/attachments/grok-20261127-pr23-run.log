"""Own a repo-backed preview HTTP server for exactly one command or scope."""
import argparse
from contextlib import contextmanager
import functools
import http.client
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading
import time


ROOT = Path(__file__).resolve().parent.parent
ENTRY = '/render/index.html'
LOOPBACK = {'127.0.0.1', 'localhost'}


class PreviewInterrupted(KeyboardInterrupt):
    def __init__(self, signum):
        self.signum = signum


def _stop(process, *, group=False):
    """Reap only the child we spawned; never look up or kill a port owner."""
    if process.poll() is None:
        try:
            if group:
                os.killpg(process.pid, signal.SIGTERM)
            else:
                process.terminate()
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                if group:
                    os.killpg(process.pid, signal.SIGKILL)
                else:
                    process.kill()
            except ProcessLookupError:
                pass
    process.wait()


def _probe(host, port, index, timeout):
    """A TCP listener alone does not mean it can serve this checkout's preview."""
    connection = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        connection.request('GET', ENTRY)
        with connection.getresponse() as response:
            return response.status == 200 and response.read(len(index) + 1) == index
    except (OSError, http.client.HTTPException):
        return False
    finally:
        connection.close()


def _start(root, port):
    return subprocess.Popen(
        [sys.executable, '-m', 'http.server', str(port), '--bind', '127.0.0.1',
         '--directory', str(root)],
        cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


@contextmanager
def preview_server(*, root=ROOT, timeout=10.0):
    """Yield the owned Popen, or None when reusing a service. Always reap owned PIDs."""
    host = os.environ.get('RENDER_HOST') or '127.0.0.1'
    port = int(os.environ.get('RENDER_PORT') or '8765')
    if not 1 <= port <= 65535 or timeout <= 0:
        raise ValueError('RENDER_PORT must be 1..65535 and the startup timeout must be positive')
    root = Path(root).resolve()
    index = (root / ENTRY.lstrip('/')).read_bytes()
    process = None
    previous = {}
    deferred = True
    pending = None

    def interrupt(signum, _frame):
        nonlocal pending
        if deferred:
            pending = signum
        else:
            raise PreviewInterrupted(signum)

    try:
        if threading.current_thread() is threading.main_thread():
            for sig in (signal.SIGINT, signal.SIGTERM):
                previous[sig] = signal.signal(sig, interrupt)
        deadline = time.monotonic() + timeout
        if not _probe(host, port, index, min(0.2, timeout)):
            if host in LOOPBACK:
                process = _start(root, port)
            deferred = False
            if pending is not None:
                raise PreviewInterrupted(pending)
            while (remaining := deadline - time.monotonic()) > 0:
                if _probe(host, port, index, min(0.2, remaining)):
                    # Another owner may win the bind race. An exited child is
                    # reaped by poll; the service that answered remains untouched.
                    if process is not None and process.poll() is not None:
                        process = None
                    break
                if process is not None and process.poll() is not None:
                    raise RuntimeError(f'Preview server exited ({process.returncode}): http://{host}:{port}{ENTRY}')
                time.sleep(min(0.05, max(0, deadline - time.monotonic())))
            else:
                raise TimeoutError(f'Preview server not ready: http://{host}:{port}{ENTRY}')
        deferred = False
        if pending is not None:
            raise PreviewInterrupted(pending)
        yield process
    finally:
        deferred = True
        try:
            if process is not None:
                _stop(process)
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def with_preview_server(function):
    """Wrap a renderer entry point without changing its arguments or return value."""
    @functools.wraps(function)
    def run(*args, **kwargs):
        with preview_server():
            return function(*args, **kwargs)
    return run


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--cwd', help='working directory for the render command')
    parser.add_argument('command', nargs=argparse.REMAINDER, help='-- COMMAND [ARGS...]')
    args = parser.parse_args(argv)
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('a render command is required')
    group = os.name == 'posix'
    try:
        with preview_server():
            # Register the child before making a caught signal interruptible.
            # The CLI is single-threaded; temporarily defer both signals during spawn.
            pending = []
            signals = (signal.SIGINT, signal.SIGTERM)
            previous = {sig: signal.signal(sig, lambda signum, _frame: pending.append(signum))
                        for sig in signals}
            child = None
            try:
                try:
                    child = subprocess.Popen(command, cwd=args.cwd, start_new_session=group)
                finally:
                    for sig, handler in previous.items():
                        signal.signal(sig, handler)
                if pending:
                    raise PreviewInterrupted(pending[0])
                status = child.wait()
                return status if status >= 0 else 128 - status
            finally:
                if child is not None and child.poll() is None:
                    # A second signal must not interrupt reaping the command we started.
                    previous = {sig: signal.signal(sig, signal.SIG_IGN) for sig in signals}
                    try:
                        _stop(child, group=group)
                    finally:
                        for sig, handler in previous.items():
                            signal.signal(sig, handler)
    except PreviewInterrupted as exc:
        return 128 + exc.signum
    except (OSError, ValueError, RuntimeError) as exc:
        print(f'[preview] {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())

def cmd_check(a):
    """AI-facing gate: run validators and print structured FIX blocks. Default = all built chars or --char."""
    import ai_gate
    stages = [s.strip() for s in (a.stage or 'all').split(',') if s.strip()]
    sel = [c.strip() for c in a.char.split(',') if c.strip()] if a.char else [c for c in chars() if is_built(c)]
    if not a.char:
        for c in chars():
            if not is_built(c):
                print(f'[pipeline] check SKIP {c}: not built (no skeleton JSON) — run build after accept-source')
    if not sel:
        die('no characters to check (pass --char or build some first)', 'tools/pipeline.py check')
    bad = []
    for c in sel:
        if ai_gate.check_char(c, stages):
            bad.append(c)
    if bad:
        print('[pipeline] check FAIL for: ' + ', '.join(bad))
        print('[pipeline] 禁止放寬容差 / 手改 out/*.json / 跳過檢查。讀每則 FIX 區塊後重跑。')
        sys.exit(1)
    print('[pipeline] check PASS:', ', '.join(sel))


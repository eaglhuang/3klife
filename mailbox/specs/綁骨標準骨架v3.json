    "names": ["pelvis", "torso", "head", "cape", "hair_tail", "skirt", "arm_upper_f", "arm_lower_f", "hand_f", "pauldron_f", "weapon", "arm_upper_b", "arm_lower_b", "hand_b", "pauldron_b", "thigh_f", "shin_f", "foot_f", "thigh_b", "shin_b", "foot_b"],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atm://schemas/language-diagnostics.schema.json",
  "title": "Language Diagnostics Report",
  "type": "object",
  "required": [
    "diagnostics"
  ],
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "location": {
            "$ref": "language-symbol-range-reference.schema.json#/$defs/sourceRange"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}


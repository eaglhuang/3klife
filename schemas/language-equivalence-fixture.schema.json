{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atm://schemas/language-equivalence-fixture.schema.json",
  "title": "Language Equivalence Fixture Contract",
  "type": "object",
  "required": [
    "fixtureId",
    "input",
    "expectedBehavior",
    "evidencePaths"
  ],
  "properties": {
    "fixtureId": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expectedBehavior": {
      "type": "string"
    },
    "evidencePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}


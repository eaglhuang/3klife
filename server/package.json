{
  "name": "game-server-prototype",
  "version": "1.0.0",
  "description": "後端驗證服務原型 (Event Sourcing / Event Replaying)",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke:health": "node scripts/run-health-smoke.js",
    "smoke:db": "node scripts/run-db-smoke.js",
    "smoke:sync": "node scripts/run-sync-smoke.js",
    "smoke:all": "npm run smoke:health && npm run smoke:sync",
    "smoke:all:strict": "npm run smoke:db && npm run smoke:sync"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

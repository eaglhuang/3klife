{
  "cases": [
    {
      "id": "bundled-python-preferred",
      "request": {
        "languageId": "python",
        "requiredCapabilities": [
          "sourceInventory",
          "atomizeDryRun",
          "runtimeCommandDetection"
        ],
        "allowPartialCapability": true,
        "discoveryInput": {
          "bundledAdapters": [
            {
              "adapterId": "py-bundled",
              "moduleName": "@ai-atomic-framework/language-python",
              "source": "bundled",
              "languageIds": ["python"],
              "contractVersion": "v2",
              "priority": 5,
              "capabilities": {
                "sourceInventory": "full",
                "atomizeDryRun": "full",
                "runtimeCommandDetection": "partial"
              }
            }
          ],
          "externalAdapters": [
            {
              "adapterId": "py-external",
              "moduleName": "@vendor/language-python",
              "source": "external",
              "languageIds": ["python"],
              "contractVersion": "v2",
              "priority": 50,
              "capabilities": {
                "sourceInventory": "full",
                "atomizeDryRun": "full",
                "runtimeCommandDetection": "full"
              }
            }
          ]
        }
      },
      "expect": {
        "selectedAdapterId": "py-bundled",
        "ok": true,
        "advisory": ["runtimeCommandDetection"],
        "unsupported": []
      }
    },
    {
      "id": "external-go-only",

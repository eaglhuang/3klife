            {
              "adapterId": "go-external",
              "moduleName": "@vendor/language-go",
              "source": "external",
              "languageIds": ["go"],
              "contractVersion": "v2",
              "priority": 10,
              "capabilities": {
                "sourceInventory": "full",
                "runtimeCommandDetection": "full"
              }
            }
          ]
        }
      },
      "expect": {
        "selectedAdapterId": "go-external",
        "ok": true,
        "advisory": [],
        "unsupported": []
      }
    },
    {
      "id": "missing-capability",
      "request": {
        "languageId": "javascript",
        "requiredCapabilities": ["sourceInventory", "atomizeDryRun"],
        "allowPartialCapability": false,
        "discoveryInput": {
          "bundledAdapters": [
            {
              "adapterId": "js-bundled",
              "moduleName": "@ai-atomic-framework/language-js",
              "source": "bundled",
              "languageIds": ["javascript", "typescript"],
              "contractVersion": "v2",
              "priority": 3,
              "capabilities": {
                "sourceInventory": "full",
                "atomizeDryRun": "none"

+    def _scene_diagnostic_issues(
+        self,
+        *,
+        data_status: str,
+        source_coverage: SceneSourceCoverage,
+        story_generation: DialogueGenerationResult,
+        chorus_target_count: int,
+        chorus_lines: list[SceneChorusLine],
+    ) -> list[str]:

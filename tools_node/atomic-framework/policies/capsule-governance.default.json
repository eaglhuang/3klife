{
  "schemaId": "atm.capsuleGovernancePolicy",
  "specVersion": "0.1.0",
  "thresholds": {
    "functionLinesWarn": 80,
    "functionLinesBlockRelease": 250,
    "familyPromotionMinCount": 3,
    "duplicateFingerprintAction": "reuse-or-merge"
  },
  "tiers": {
    "local-capsule": {
      "metadataRequired": true,
      "behaviorTemplateRequired": false
    },
    "local-capsule-candidate": {
      "metadataRequired": true,
      "behaviorTemplateRequired": true
    },
    "governed-atom": {
      "metadataRequired": true,
      "behaviorTemplateRequired": true
    },
    "shared-atom": {
      "metadataRequired": true,
      "behaviorTemplateRequired": true
    }
  },
  "testRequirements": {
    "candidate": [
      "base",
      "boundary",
      "invalid"
    ],
    "blockRelease": [
      "base",
      "boundary",
      "invalid",
      "regression"
    ],
    "sideEffectRisk": [
      "boundary",
      "invalid"
    ],
    "oracleMode": "template-contract"
  },
  "sealedPolicy": {
    "defaultSplitPolicy": "splittable",
    "rules": [
      {
        "symbolPattern": "(compress|decompress|encrypt|decrypt|cipher|decipher|stateMachine|serializeState|deserializeState)",
        "splitPolicy": "sealed",
        "reason": "state-coupled-or-lossy-transform"
      }
    ]
  },
  "promotionPolicy": {
    "candidateToGoverned": {
      "requireValidateStrict": true,
      "requireAnchor": true,
      "requiredCaseSets": [
        "base",
        "boundary",
        "invalid"
      ]
    },
    "governedToShared": {
      "requireDemandPoliceSuggestion": true,
      "requireCrossWorkflowEvidence": true,
      "minUsageRefs": 2,
      "minDistinctFiles": 2,
      "minDistinctKinds": 2,
      "crossWorkflowKinds": [
        "map",
        "workflow",
        "case-study",
        "runtime",
        "tooling"
      ]
    }
  },
  "usageReferencePolicy": {
    "enabled": true,
    "includeGlobs": [
      "tools_node/**/*.js",
      "tools_node/**/*.mjs",
      "assets/scripts/**/*.ts",
      "docs/case-studies/**/*.md",
      "atomic_workbench/maps/**/*.json",
      "specs/**/*.json"
    ],
    "excludeGlobs": [
      "node_modules/**",
      "artifacts/**",
      "atomic_workbench/capsules/**",
      "library/**",
      "temp/**",
      "server/dist/**",
      ".git/**"
    ],
    "maxRefsPerSymbol": 24,
    "externalScanMaxDepth": 2
  },
  "anchorPolicy": {
    "required": true,
    "idPrefix": "H2U-ANCHOR",
    "kind": "core-anchor",
    "role": "semantic-parent",
    "allowSharedPromotion": false
  }
}
